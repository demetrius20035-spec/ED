// ============================================================================
// Универсальная выгрузка ДХ: состав объектов задаёт функция ОписаниеВыгрузки()
// (генерируется из metadata_selected_cleaned.json скриптом tools/generate_export.py).
// Все объекты выгружаются одним прогоном с ОБЩИМ манифестом.
// Существующие процедуры по отдельным объектам остаются для совместимости,
// при включении этих двух заданий их задания нужно отключить.
// ============================================================================

Процедура EnterpriseData_Час_ДХ() Экспорт
	ВыполнитьВыгрузкуДХ(Ложь);
КонецПроцедуры

Процедура EnterpriseData_Неделя_ДХ() Экспорт
	ВыполнитьВыгрузкуДХ(Истина);
КонецПроцедуры

Процедура ВыполнитьВыгрузкуДХ(Полная)

	тДата = НачалоЧаса(ТекущаяДата());

	// Конец периода (текущее UTC)
	ДатаКонцаUTC = тДата - 3*60*60;
	ДатаКонца_yyMMddСтрока = Строка(Формат(ДатаКонцаUTC, "ДФ=yyyy-MM-dd"));
	ДатаКонца_ЧЧммсс_СТиреСтрока = Строка(Формат(ДатаКонцаUTC, "ДФ=ЧЧ-мм-сс"));
	ДатаКонца_ЧЧммсс_СДвоеточиемСтрока = Строка(Формат(ДатаКонцаUTC, "ДФ=ЧЧ:мм:сс"));

	ДатаКонцаГринвичуСТире = ДатаКонца_yyMMddСтрока + "T" + ДатаКонца_ЧЧммсс_СТиреСтрока + "Z";
	ДатаКонцаПоГринвичуСДвоеточиемСтрока = ДатаКонца_yyMMddСтрока + "T" + ДатаКонца_ЧЧммсс_СДвоеточиемСтрока + "Z";

	// Начало периода (UTC минус 1 час)
	ДатаНачалаUTC = тДата - 4*60*60;
	ДатаДанныхДо_yyMMdd_Строка = Строка(Формат(ДатаНачалаUTC, "ДФ=yyyy-MM-dd"));

	ДатаНачала_ЧЧммсс_СДвоеточиемСтрока = Строка(Формат(ДатаНачалаUTC, "ДФ=ЧЧ:мм:сс"));
	ДатаНачалаПоГринвичуСДвоеточиемСтрока = ДатаДанныхДо_yyMMdd_Строка + "T" + ДатаНачала_ЧЧммсс_СДвоеточиемСтрока + "Z";

	Region = "ru-central1";
	Bucket = "ru-dxbx-mega-export";

	AccessKey = "";
	SecretKey = "";

	// Путь к Ruby‑скрипту (обратите внимание на двойные обратные слеши)
	ПутьКСкрипту = "C:\proj\aws_upload_yandexcloud_s3.rb";
	ПутьКРуби = "C:\Ruby34-x64\bin\ruby.exe";

	ПараметрыS3 = Новый Структура;
	ПараметрыS3.Вставить("AccessKey", AccessKey);
	ПараметрыS3.Вставить("SecretKey", SecretKey);
	ПараметрыS3.Вставить("Region", Region);
	ПараметрыS3.Вставить("Bucket", Bucket);
	ПараметрыS3.Вставить("ПутьКРуби", ПутьКРуби);
	ПараметрыS3.Вставить("ПутьКСкрипту", ПутьКСкрипту);

	ВидВыгрузки = ?(Полная, "full", "incremental");
	ИмяЗадания = "Регламентное задание EnterpriseData_" + ?(Полная, "Неделя", "Час") + "_ДХ";
	Префикс = "mega-export/" + ВидВыгрузки + "/" + ДатаКонцаГринвичуСТире + "/";

	// Каждому запуску - свой временный каталог: параллельные задания
	// не перезаписывают файлы и манифесты друг друга
	КаталогВыгрузки = КаталогВременныхФайлов() + "\DH_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "") + "\";
	КаталогВыгрузки = СтрЗаменить(КаталогВыгрузки, "\\", "\");
	СоздатьКаталог(КаталогВыгрузки);

	НачалоПериода = тДата - 60 * 70; // 1 час 10 минут назад
	КонецПериода = тДата;

	Итоги = Новый Массив;

	Для Каждого Настройка Из ОписаниеВыгрузки() Цикл

		ПутьКФайлу = КаталогВыгрузки + Настройка.ИмяФайла;

		Если Настройка.ВидИсточника = "РегистрНакопления" Тогда

			// Регистры выгружаются построчно напрямую в файл;
			// ошибка одного регистра не прерывает выгрузку остальных источников
			ФайлОбмена = НачатьФайлВыгрузкиДХ(ПутьКФайлу);
			Попытка
				КоличествоЗаписей = ВыгрузитьРегистрГен(Настройка.ИмяМетаданных, ФайлОбмена, Полная, НачалоПериода, КонецПериода);
			Исключение
				КоличествоЗаписей = 0;
				ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяЗадания, УровеньЖурналаРегистрации.Ошибка,,,
					"Ошибка выгрузки " + Настройка.ИмяМетаданных + ": " + ОписаниеОшибки());
			КонецПопытки;
			ЗавершитьФайлВыгрузкиДХ(ФайлОбмена);

			Итог = Новый Структура("Entity, ИмяФайла, Количество",
				Настройка.Entity, Настройка.ИмяФайла, КоличествоЗаписей);
			Итоги.Добавить(Итог);

			Если КоличествоЗаписей > 0 Тогда
				КодВозврата = ЗагрузитьФайлВS3(ПутьКФайлу, Префикс + Настройка.ИмяФайла, ПараметрыS3);
				Если КодВозврата <> 0 Тогда
					ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяЗадания, УровеньЖурналаРегистрации.Ошибка,,,
						"Ошибка при загрузке файла " + Настройка.ИмяФайла + " в облачное хранилище (код: " + КодВозврата + ")");
				КонецЕсли;
			КонецЕсли;

			Продолжить;

		КонецЕсли;

		// Объектные источники (справочники и документы)
		МассивСсылок = ВыбратьСсылкиДляВыгрузки(Настройка, Полная, НачалоПериода, КонецПериода);

		Итог = Новый Структура("Entity, ИмяФайла, Количество",
			Настройка.Entity, Настройка.ИмяФайла, МассивСсылок.Количество());
		Итоги.Добавить(Итог);

		Если МассивСсылок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		АдресВременногоХранилища = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
		ВыгрузитьДанные(МассивСсылок, АдресВременногоХранилища);
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
		ДвоичныеДанные.Записать(ПутьКФайлу);

		КодВозврата = ЗагрузитьФайлВS3(ПутьКФайлу, Префикс + Настройка.ИмяФайла, ПараметрыS3);
		Если КодВозврата <> 0 Тогда
			ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяЗадания, УровеньЖурналаРегистрации.Ошибка,,,
				"Ошибка при загрузке файла " + Настройка.ИмяФайла + " в облачное хранилище (код: " + КодВозврата + ")");
		КонецЕсли;

	КонецЦикла;

	// Общий манифест
	EnterpriseDataVersion = "1.6.23";
	ExtensionVersion = "1.0.0";

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписьJSON.ЗаписатьИмяСвойства("export_type");
	ЗаписьJSON.ЗаписатьЗначение(ВидВыгрузки);
	ЗаписьJSON.ЗаписатьИмяСвойства("from_ts");
	ЗаписьJSON.ЗаписатьЗначение(ДатаНачалаПоГринвичуСДвоеточиемСтрока);
	ЗаписьJSON.ЗаписатьИмяСвойства("to_ts");
	ЗаписьJSON.ЗаписатьЗначение(ДатаКонцаПоГринвичуСДвоеточиемСтрока);
	ЗаписьJSON.ЗаписатьИмяСвойства("enterprise_data_version");
	ЗаписьJSON.ЗаписатьЗначение(EnterpriseDataVersion);
	ЗаписьJSON.ЗаписатьИмяСвойства("extension_version");
	ЗаписьJSON.ЗаписатьЗначение(ExtensionVersion);
	ЗаписьJSON.ЗаписатьИмяСвойства("entities");
	ЗаписьJSON.ЗаписатьНачалоОбъекта();

	СтрокаИтогов = "";
	Для Каждого Итог Из Итоги Цикл

		// В инкрементальный манифест не включаем пустые сущности, в полный - все
		Если Полная Или Итог.Количество > 0 Тогда
			ЗаписьJSON.ЗаписатьИмяСвойства(Итог.Entity);
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписьJSON.ЗаписатьИмяСвойства("count");
			ЗаписьJSON.ЗаписатьЗначение(Итог.Количество);
			ЗаписьJSON.ЗаписатьИмяСвойства("file");
			ЗаписьJSON.ЗаписатьЗначение(Итог.ИмяФайла);
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЕсли;

		СтрокаИтогов = СтрокаИтогов + ?(СтрокаИтогов = "", "", " / ") + Итог.Entity + " = " + Итог.Количество;

	КонецЦикла;

	ЗаписьJSON.ЗаписатьКонецОбъекта();
	ЗаписьJSON.ЗаписатьКонецОбъекта();
	СтрокаJSON = ЗаписьJSON.Закрыть();

	ПутьМанифест = КаталогВыгрузки + "manifest.json";
	ТекстовыйФайл = Новый ТекстовыйДокумент;
	ТекстовыйФайл.УстановитьТекст(СтрокаJSON);
	ТекстовыйФайл.Записать(ПутьМанифест, КодировкаТекста.UTF8);

	КодВозврата = ЗагрузитьФайлВS3(ПутьМанифест, Префикс + "manifest.json", ПараметрыS3);
	Если КодВозврата <> 0 Тогда
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяЗадания, УровеньЖурналаРегистрации.Ошибка,,,
			"Ошибка при загрузке манифеста в облачное хранилище (код: " + КодВозврата + ")");
	КонецЕсли;

	Попытка
		УдалитьФайлы(КаталогВыгрузки);
	Исключение
		// не смогли прибрать за собой - не критично
	КонецПопытки;

	Попытка
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяЗадания, УровеньЖурналаРегистрации.Информация,,, СтрокаИтогов);
	Исключение
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ОписаниеОшибки(), УровеньЖурналаРегистрации.Ошибка,,,);
	КонецПопытки;

КонецПроцедуры // ВыполнитьВыгрузкуДХ()

// Формирует массив ссылок для выгрузки по одной строке описания.
// Полная = Истина  - все объекты (с учётом отбора и проведённости);
// Полная = Ложь    - изменения за период по справочнику АудиторскийСлед,
//                    для документов дополнительно по дате документа.
Функция ВыбратьСсылкиДляВыгрузки(Настройка, Полная, НачалоПериода, КонецПериода)

	МассивСсылок = Новый Массив;

	Запрос = Новый Запрос;

	Если Полная Тогда

		ТекстЗапроса = "ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	" + Настройка.ИмяМетаданных + " КАК Т";

		Условия = Новый Массив;
		Если Настройка.Отбор = "Элементы" Тогда
			Условия.Добавить("Т.ЭтоГруппа = ЛОЖЬ");
		ИначеЕсли Настройка.Отбор = "Группы" Тогда
			Условия.Добавить("Т.ЭтоГруппа = ИСТИНА");
		КонецЕсли;
		Если Настройка.Проводимый Тогда
			Условия.Добавить("Т.Проведен = ИСТИНА");
		КонецЕсли;
		// Горизонт полной выгрузки документов (задаётся в generate_export.py)
		Если Настройка.ГоризонтДней > 0 Тогда
			Условия.Добавить("Т.Дата >= &НачалоГоризонта");
			Запрос.УстановитьПараметр("НачалоГоризонта", НачалоДня(ТекущаяДата() - Настройка.ГоризонтДней * 86400));
		КонецЕсли;

		Если Условия.Количество() > 0 Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|ГДЕ
			|	" + СтрСоединить(Условия, "
			|	И ");
		КонецЕсли;

	Иначе

		УсловияСледа = Новый Массив;
		УсловияСледа.Добавить("АудиторскийСлед.Дата МЕЖДУ &НачалоПериода И &КонецПериода");
		УсловияСледа.Добавить("АудиторскийСлед.Объект ССЫЛКА " + Настройка.ИмяМетаданных);
		УсловияСледа.Добавить("АудиторскийСлед.Объект.Ссылка ЕСТЬ НЕ NULL");
		Если Настройка.Отбор = "Элементы" Тогда
			УсловияСледа.Добавить("АудиторскийСлед.Объект.ЭтоГруппа = ЛОЖЬ");
		ИначеЕсли Настройка.Отбор = "Группы" Тогда
			УсловияСледа.Добавить("АудиторскийСлед.Объект.ЭтоГруппа = ИСТИНА");
		КонецЕсли;
		Если Настройка.Проводимый Тогда
			УсловияСледа.Добавить("АудиторскийСлед.Объект.Проведен = ИСТИНА");
		КонецЕсли;

		ТекстЗапроса = "ВЫБРАТЬ
		|	АудиторскийСлед.Объект КАК Ссылка
		|ИЗ
		|	Справочник.АудиторскийСлед КАК АудиторскийСлед
		|ГДЕ
		|	" + СтрСоединить(УсловияСледа, "
		|	И ") + "
		|
		|СГРУППИРОВАТЬ ПО
		|	АудиторскийСлед.Объект";

		// Документы дополнительно отбираем по дате документа
		// (подстраховка, если аудиторский след не зарегистрировал изменение);
		// ОБЪЕДИНИТЬ без ВСЕ убирает дубли
		Если Настройка.Проводимый Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	Т.Ссылка
			|ИЗ
			|	" + Настройка.ИмяМетаданных + " КАК Т
			|ГДЕ
			|	Т.Дата МЕЖДУ &НачалоПериода И &КонецПериода
			|	И Т.Проведен = ИСТИНА";
		КонецЕсли;

		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	КонецЕсли;

	Запрос.Текст = ТекстЗапроса;

	Попытка
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Исключение
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Выгрузка ДХ", УровеньЖурналаРегистрации.Ошибка,,,
			"Ошибка выборки " + Настройка.ИмяМетаданных + ": " + ОписаниеОшибки());
		Возврат МассивСсылок;
	КонецПопытки;

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивСсылок.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;

	Возврат МассивСсылок;

КонецФункции // ВыбратьСсылкиДляВыгрузки()

// Открывает файл выгрузки и пишет обвязку Message/Header/Body (как ВыгрузитьДанные).
// Используется для источников, выгружаемых напрямую (регистры накопления).
Функция НачатьФайлВыгрузкиДХ(ИмяФайла)

	ФайлОбмена = Новый ЗаписьXML;
	ФайлОбмена.ОткрытьФайл(ИмяФайла);
	ФайлОбмена.ЗаписатьОбъявлениеXML();

	ФайлОбмена.ЗаписатьНачалоЭлемента("Message");
	ФайлОбмена.ЗаписатьСоответствиеПространстваИмен("msg", "http://www.1c.ru/SSL/Exchange/Message");
	ФайлОбмена.ЗаписатьСоответствиеПространстваИмен("xs", "http://www.w3.org/2001/XMLSchema");
	ФайлОбмена.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance");
	ФайлОбмена.ЗаписатьСоответствиеПространстваИмен("ext", URIРасширение());

	Header = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(XMLБазоваяСхема(), "Header"));
	Header.Format 		= "http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.6";
	Header.CreationDate = ТекущаяДата();
	Header.AvailableVersion.Добавить("1.6");

	ФабрикаXDTO.ЗаписатьXML(ФайлОбмена, Header);

	ФайлОбмена.ЗаписатьНачалоЭлемента("Body");
	ФайлОбмена.ЗаписатьСоответствиеПространстваИмен("", "http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.6");

	Возврат ФайлОбмена;

КонецФункции // НачатьФайлВыгрузкиДХ()

Процедура ЗавершитьФайлВыгрузкиДХ(ФайлОбмена)

	ФайлОбмена.ЗаписатьКонецЭлемента(); // Body
	ФайлОбмена.ЗаписатьКонецЭлемента(); // Message
	ФайлОбмена.Закрыть();

КонецПроцедуры // ЗавершитьФайлВыгрузкиДХ()

// Загружает файл в S3 через Ruby-скрипт. Возвращает код возврата (0 - успех).
Функция ЗагрузитьФайлВS3(ЛокальныйПуть, КлючОбъекта, ПараметрыS3)

	Команда = """" + ПараметрыS3.ПутьКРуби + """" + " """ + ПараметрыS3.ПутьКСкрипту + """" +
	" --access-key " + ПараметрыS3.AccessKey +
	" --secret-key " + ПараметрыS3.SecretKey +
	" --region " + ПараметрыS3.Region +
	" --bucket " + ПараметрыS3.Bucket +
	" --object-name """ + КлючОбъекта + """" +
	" --file-path """ + ЛокальныйПуть;

	WshShell = Новый COMОбъект("WScript.Shell");
	Возврат WshShell.Run(Команда, 0, Истина); // 0 — скрытое окно, Истина — ждём завершения

КонецФункции // ЗагрузитьФайлВS3()

