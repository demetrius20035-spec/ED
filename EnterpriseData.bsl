Функция СоздатьЗначениеXDTO(Тип)

	// Сначала ищем тип в расширенном пакете: если тип переопределён в расширении
	// (наследник типового с добавленными свойствами), создастся именно расширенный тип
	ТипXDTO = ФабрикаXDTO.Тип(URIРасширение(), Тип);

	// Если в расширенном пакете типа нет — берём типовой из EnterpriseData_1_6_23
	Если ТипXDTO = Неопределено Тогда
		ТипXDTO = ФабрикаXDTO.Тип(URI(), Тип);
	КонецЕсли;

	Если ТипXDTO = Неопределено Тогда
		ВызватьИсключение "XDTO-тип '" + Тип + "' не найден ни в расширенном, ни в типовом пакете";
	КонецЕсли;

	Возврат ФабрикаXDTO.Создать(ТипXDTO);

КонецФункции // СоздатьЗначениеXDTO()

// Создаёт значение строго ТИПОВОГО типа (пакет 1.6), минуя поиск в расширенном
// пакете: используется творцами ключевых свойств типовых объектов, чьи имена
// затенены одноимёнными сгенерированными типами расширенного пакета
Функция СоздатьТиповоеЗначениеXDTO(Тип)

	Возврат ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(URI(), Тип));

КонецФункции // СоздатьТиповоеЗначениеXDTO()

// Записывает объект XDTO в файл обмена.
//
// Объект расширенного типа, унаследованного от типового (базовый тип из пакета 1.6),
// записывается элементом с именем базового типа в типовом пространстве имён
// и атрибутом xsi:type расширенного типа: типовая структура файла не меняется,
// а реквизиты, добавленные в расширении, попадают в тот же элемент.
// Прочие объекты (чисто типовые или чисто расширенные) записываются как есть.
Процедура ЗаписатьОбъектXDTO(ФайлОбмена, ДанныеXDTO)

	ТипОбъекта = ДанныеXDTO.Тип();

	Если ТипОбъекта.URIПространстваИмен = URIРасширение()
		И ТипОбъекта.БазовыйТип <> Неопределено
		И ТипОбъекта.БазовыйТип.URIПространстваИмен = URI() Тогда

		ФабрикаXDTO.ЗаписатьXML(ФайлОбмена, ДанныеXDTO,
			ТипОбъекта.БазовыйТип.Имя, URI(), , НазначениеТипаXML.Явное);

	Иначе
		ФабрикаXDTO.ЗаписатьXML(ФайлОбмена, ДанныеXDTO);
	КонецЕсли;

КонецПроцедуры // ЗаписатьОбъектXDTO()

Функция ПолучитьСтавкуНДС(СтавкаНДС)
	
	Если Не ЗначениеЗаполнено(СтавкаНДС) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если СтавкаНДС = Справочники.СтавкиНДС.БезНДС Тогда
		ЗначениеПеречисления = "БезНДС";
	ИначеЕсли СтавкаНДС = Справочники.СтавкиНДС.ЛьготнаяСтавкаНДС5 Тогда
		ЗначениеПеречисления = "НДС10";
	ИначеЕсли СтавкаНДС = Справочники.СтавкиНДС.ЛьготнаяСтавкаНДС7 Тогда
		ЗначениеПеречисления = "НДС7";
	ИначеЕсли СтавкаНДС = Справочники.СтавкиНДС.ЛьготнаяСтавкаНДС10 Тогда
		ЗначениеПеречисления = "НДС10";
	ИначеЕсли СтавкаНДС = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС18 Тогда
		ЗначениеПеречисления = "НДС18";
	ИначеЕсли СтавкаНДС = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС20 Тогда
		ЗначениеПеречисления = "НДС20";
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	ТипЗначенияXDTO = ФабрикаXDTO.Тип(URI(), "СтавкиНДС");
	
	ЗначениеXDTO = ФабрикаXDTO.Создать(ТипЗначенияXDTO, ЗначениеПеречисления);
	
	Возврат ЗначениеXDTO;
	
КонецФункции // ПолучитьСтавкуНДС()

Процедура УстановитьДанные(ДанныеXDTO, ИмяДанныхXDTO, Значение)
	
	Если ТипЗнч(Значение) = Тип("ОбъектXDTO") Тогда
		// Для XDTO-объектов
		Если Значение.Свойства().Получить("Строка") = Неопределено Или Значение.Строка.Количество() > 0 Тогда
			ДанныеXDTO[ИмяДанныхXDTO] = Значение;
		КонецЕсли;
	Иначе
		// Для простых типов - проверяем заполненность и пустую дату
		Если ЗначениеЗаполнено(Значение) И (ТипЗнч(Значение) <> Тип("Дата") Или Значение <> '00010101') Тогда
			ДанныеXDTO[ИмяДанныхXDTO] = Значение;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция СоздатьКлючевоеСвойство_Валюта(Значение, ФайлОбмена, КЭШ, Документ)
	
	КлючевоеСвойство = СоздатьТиповоеЗначениеXDTO("КлючевыеСвойстваВалюта");
	КлючевоеСвойство.Ссылка 		= "" + Значение.УникальныйИдентификатор();
	
	КлючевоеСвойство.Код = Значение.Код;
	КлючевоеСвойство.Наименование = Значение.Наименование;
	
	//ОбщиеСвойстваДанныеКлассификатора = СоздатьТиповоеЗначениеXDTO("ОбщиеСвойстваДанныеКлассификатора");
	//ОбщиеСвойстваДанныеКлассификатора.Код = Значение.Код;
	//ОбщиеСвойстваДанныеКлассификатора.Наименование = Значение.Наименование;
	//
	//КлючевоеСвойство.ДанныеКлассификатора = ОбщиеСвойстваДанныеКлассификатора;
	
	ДанныеXDTO = СоздатьТиповоеЗначениеXDTO("Справочник.Валюты");
	ДанныеXDTO.КлючевыеСвойства	= КлючевоеСвойство;
	ДанныеXDTO.НаименованиеПолное = Значение.НаименованиеПолное;
	
	
	Возврат КлючевоеСвойство;
	
КонецФункции // СоздатьКлючевоеСвойство_Валюта()

Функция СоздатьКлючевоеСвойство_Организация(Значение, ФайлОбмена, КЭШ, Документ)
	
	КлючевоеСвойство = СоздатьТиповоеЗначениеXDTO("КлючевыеСвойстваОрганизация");
	КлючевоеСвойство.Ссылка = "" + Значение.УникальныйИдентификатор();
	КлючевоеСвойство.Наименование 				= Значение.Наименование;
	КлючевоеСвойство.НаименованиеСокращенное 	= Значение.Наименование;
	КлючевоеСвойство.НаименованиеПолное 		= Значение.НаименованиеПолное;
	КлючевоеСвойство.ИНН 						= Значение.ИНН;
	
	Если СтрДлина(КлючевоеСвойство.ИНН) = 10 Тогда
		КлючевоеСвойство.КПП 						= Значение.КППСтр;
		КлючевоеСвойство.ЮридическоеФизическоеЛицо	= "ЮридическоеЛицо";
	ИначеЕсли СтрДлина(КлючевоеСвойство.ИНН) = 12 Тогда
		КлючевоеСвойство.ЮридическоеФизическоеЛицо	= "ФизическоеЛицо";
	КонецЕсли;
	
	ДанныеXDTO = СоздатьТиповоеЗначениеXDTO("Справочник.Организации");
	ДанныеXDTO.КлючевыеСвойства	= КлючевоеСвойство;
	ДанныеXDTO.ОГРН = Лев(СокрЛП(Значение.ОГРН), 15);
	
	Если СтрДлина(КлючевоеСвойство.ИНН) = 12 Тогда
		
		КлючевыеСвойстваФизическоеЛицо = СоздатьТиповоеЗначениеXDTO("КлючевыеСвойстваФизическоеЛицо");
		
		КлючевыеСвойстваФизическоеЛицо.ФИО = Значение.ФизическоеЛицо.Наименование;
		КлючевыеСвойстваФизическоеЛицо.Фамилия = Значение.ФизическоеЛицо.Фамилия;
		КлючевыеСвойстваФизическоеЛицо.Имя = Значение.ФизическоеЛицо.Имя;
		КлючевыеСвойстваФизическоеЛицо.Отчество = Значение.ФизическоеЛицо.Отчество;
		КлючевыеСвойстваФизическоеЛицо.ДатаРождения = Значение.ФизическоеЛицо.ДатаРождения;
