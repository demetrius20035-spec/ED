Функция ПолучитьДанные_Ген_ПоступлениеНаРасчетныйСчет(Ссылка, ФайлОбмена, КЭШ)

	Объект = Ссылка.ПолучитьОбъект();

	ДанныеXDTO = СоздатьЗначениеXDTO("Документ.ПоступлениеНаРасчетныйСчет");
	ДанныеXDTO.КлючевыеСвойства = КлючевоеСвойствоГен_ПоступлениеНаРасчетныйСчет(Ссылка);

	УстановитьДанные(ДанныеXDTO, "Операция", КлючевоеСвойствоГен_Операции(Объект.Операция));
	Если ЗначениеЗаполнено(Объект.Автор) Тогда
		УстановитьДанные(ДанныеXDTO, "Автор", XMLСтрока(Объект.Автор));
	КонецЕсли;
	УстановитьДанные(ДанныеXDTO, "ДатаСоздания", Объект.ДатаСоздания);
	ДанныеXDTO.БухгалтерскийУчет = Объект.БухгалтерскийУчет;
	ДанныеXDTO.УправленческийУчет = Объект.УправленческийУчет;
	УстановитьДанные(ДанныеXDTO, "Организация", ПолучитьКлючевоеСвойство(Объект.Организация, ФайлОбмена, КЭШ, Ссылка));
	УстановитьДанные(ДанныеXDTO, "Подразделение", ПолучитьКлючевоеСвойство(Объект.Подразделение, ФайлОбмена, КЭШ, Ссылка));
	УстановитьДанные(ДанныеXDTO, "СчетОрганизации", ПолучитьКлючевоеСвойство(Объект.СчетОрганизации, ФайлОбмена, КЭШ, Ссылка));
	УстановитьДанные(ДанныеXDTO, "Всего", Объект.Всего);
	УстановитьДанные(ДанныеXDTO, "ВсегоНДС", Объект.ВсегоНДС);
	УстановитьДанные(ДанныеXDTO, "Комментарий", Объект.Комментарий);
	УстановитьДанные(ДанныеXDTO, "Контрагент", ПолучитьКлючевоеСвойство(Объект.Контрагент, ФайлОбмена, КЭШ, Ссылка));
	УстановитьДанные(ДанныеXDTO, "ДоговорКонтрагента", ПолучитьКлючевоеСвойство(Объект.ДоговорКонтрагента, ФайлОбмена, КЭШ, Ссылка));
	Если ЗначениеЗаполнено(Объект.Заказ) Тогда
		УстановитьДанные(ДанныеXDTO, "Заказ", XMLСтрока(Объект.Заказ));
	КонецЕсли;
	УстановитьДанные(ДанныеXDTO, "СчетКонтрагента", ПолучитьКлючевоеСвойство(Объект.СчетКонтрагента, ФайлОбмена, КЭШ, Ссылка));
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		УстановитьДанные(ДанныеXDTO, "ДокументОснование", XMLСтрока(Объект.ДокументОснование));
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Аналитика) Тогда
		УстановитьДанные(ДанныеXDTO, "Аналитика", XMLСтрока(Объект.Аналитика));
	КонецЕсли;
	УстановитьДанные(ДанныеXDTO, "АналитикаПредставление", Объект.АналитикаПредставление);
	УстановитьДанные(ДанныеXDTO, "НомерВходящегоДокумента", Объект.НомерВходящегоДокумента);
	УстановитьДанные(ДанныеXDTO, "ДатаВходящегоДокумента", Объект.ДатаВходящегоДокумента);
	УстановитьДанные(ДанныеXDTO, "Валюта", ПолучитьКлючевоеСвойство(Объект.Валюта, ФайлОбмена, КЭШ, Ссылка));
	УстановитьДанные(ДанныеXDTO, "Проект", ПолучитьКлючевоеСвойство(Объект.Проект, ФайлОбмена, КЭШ, Ссылка));
	УстановитьДанные(ДанныеXDTO, "Ответственный", ПолучитьКлючевоеСвойство(Объект.Ответственный, ФайлОбмена, КЭШ, Ссылка));
	УстановитьДанные(ДанныеXDTO, "СтавкаНДС", КлючевоеСвойствоГен_СтавкиНДС(Объект.СтавкаНДС));
	УстановитьДанные(ДанныеXDTO, "КурсВзаиморасчетов", Объект.КурсВзаиморасчетов);
	УстановитьДанные(ДанныеXDTO, "КратностьВзаиморасчетов", Объект.КратностьВзаиморасчетов);
	УстановитьДанные(ДанныеXDTO, "СуммаВзаиморасчетов", Объект.СуммаВзаиморасчетов);
