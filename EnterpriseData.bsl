	УстановитьДанные(ДанныеXDTO, "СтатьяДвиженияДенежныхСредств", КлючевоеСвойствоГен_СтатьиДвиженияДенежныхСредств(Объект.СтатьяДвиженияДенежныхСредств));
	Если ЗначениеЗаполнено(Объект.Счет) Тогда
		УстановитьДанные(ДанныеXDTO, "Счет", XMLСтрока(Объект.Счет));
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Субконто1) Тогда
		УстановитьДанные(ДанныеXDTO, "Субконто1", XMLСтрока(Объект.Субконто1));
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Субконто2) Тогда
		УстановитьДанные(ДанныеXDTO, "Субконто2", XMLСтрока(Объект.Субконто2));
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Субконто3) Тогда
		УстановитьДанные(ДанныеXDTO, "Субконто3", XMLСтрока(Объект.Субконто3));
