		УстановитьДанные(ДанныеXDTO, "Валюта", XMLСтрока(Объект.Валюта));
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Проект) Тогда
		УстановитьДанные(ДанныеXDTO, "Проект", XMLСтрока(Объект.Проект));
	КонецЕсли;
	УстановитьДанные(ДанныеXDTO, "Ответственный", СсылкаДХ(Объект.Ответственный));
	Если ЗначениеЗаполнено(Объект.СтавкаНДС) Тогда
		УстановитьДанные(ДанныеXDTO, "СтавкаНДС", XMLСтрока(Объект.СтавкаНДС));
	КонецЕсли;
	УстановитьДанные(ДанныеXDTO, "КурсВзаиморасчетов", Объект.КурсВзаиморасчетов);
	УстановитьДанные(ДанныеXDTO, "КратностьВзаиморасчетов", Объект.КратностьВзаиморасчетов);
