	УстановитьДанные(ДанныеXDTO, "Всего", Объект.Всего);
	УстановитьДанные(ДанныеXDTO, "Комментарий", Объект.Комментарий);
	УстановитьДанные(ДанныеXDTO, "Контрагент", ПолучитьКлючевоеСвойство(Объект.Контрагент, ФайлОбмена, КЭШ, Ссылка));
	УстановитьДанные(ДанныеXDTO, "ДоговорКонтрагента", ПолучитьКлючевоеСвойство(Объект.ДоговорКонтрагента, ФайлОбмена, КЭШ, Ссылка));
	Если ЗначениеЗаполнено(Объект.Заказ) Тогда
		УстановитьДанные(ДанныеXDTO, "Заказ", XMLСтрока(Объект.Заказ));
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		УстановитьДанные(ДанныеXDTO, "ДокументОснование", XMLСтрока(Объект.ДокументОснование));
	КонецЕсли;
