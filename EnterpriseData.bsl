		ДанныеXDTO.ПометкаУдаления = Истина;
	КонецЕсли;

	СтрокиТЧ = СоздатьЗначениеXDTO("Документ.ПоступлениеНаРасчетныйСчет.ОбщехозяйственныеРасходы");
	НомерСтроки = 0;
	Для Каждого СтрокаТЧ Из Объект.ОбщехозяйственныеРасходы Цикл
		СтрокаXDTO = СоздатьЗначениеXDTO("Документ.ПоступлениеНаРасчетныйСчет.ОбщехозяйственныеРасходы.Строка");
		НомерСтроки = НомерСтроки + 1;
		СтрокаXDTO.НомерСтрокиДокумента = НомерСтроки;
		УстановитьДанные(СтрокаXDTO, "ДатаОтнесенияЗатрат", СтрокаТЧ.ДатаОтнесенияЗатрат);
		Если ЗначениеЗаполнено(СтрокаТЧ.Организация) Тогда
			УстановитьДанные(СтрокаXDTO, "Организация", XMLСтрока(СтрокаТЧ.Организация));
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТЧ.Подразделение) Тогда
