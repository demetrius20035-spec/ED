Функция ПолучитьДанные_Ген_ПоступлениеНаРасчетныйСчет(Ссылка, ФайлОбмена, КЭШ)

	Объект = Ссылка.ПолучитьОбъект();

	ДанныеXDTO = СоздатьЗначениеXDTO("Документ.ПоступлениеНаРасчетныйСчет");
	ДанныеXDTO.КлючевыеСвойства = КлючевоеСвойствоГен_ПоступлениеНаРасчетныйСчет(Ссылка);

	Если ЗначениеЗаполнено(Объект.Операция) Тогда
		УстановитьДанные(ДанныеXDTO, "Операция", XMLСтрока(Объект.Операция));
	КонецЕсли;
	УстановитьДанные(ДанныеXDTO, "Автор", СсылкаДХ(Объект.Автор));
	УстановитьДанные(ДанныеXDTO, "ДатаСоздания", Объект.ДатаСоздания);
	ДанныеXDTO.БухгалтерскийУчет = Объект.БухгалтерскийУчет;
	ДанныеXDTO.УправленческийУчет = Объект.УправленческийУчет;
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		УстановитьДанные(ДанныеXDTO, "Организация", XMLСтрока(Объект.Организация));
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Подразделение) Тогда
		УстановитьДанные(ДанныеXDTO, "Подразделение", XMLСтрока(Объект.Подразделение));
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.СчетОрганизации) Тогда
		УстановитьДанные(ДанныеXDTO, "СчетОрганизации", XMLСтрока(Объект.СчетОрганизации));
	КонецЕсли;
	УстановитьДанные(ДанныеXDTO, "Всего", Объект.Всего);
	УстановитьДанные(ДанныеXDTO, "ВсегоНДС", Объект.ВсегоНДС);
	УстановитьДанные(ДанныеXDTO, "Комментарий", Объект.Комментарий);
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		УстановитьДанные(ДанныеXDTO, "Контрагент", XMLСтрока(Объект.Контрагент));
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ДоговорКонтрагента) Тогда
		УстановитьДанные(ДанныеXDTO, "ДоговорКонтрагента", XMLСтрока(Объект.ДоговорКонтрагента));
	КонецЕсли;
	УстановитьДанные(ДанныеXDTO, "Заказ", СсылкаДХ(Объект.Заказ));
	Если ЗначениеЗаполнено(Объект.СчетКонтрагента) Тогда
		УстановитьДанные(ДанныеXDTO, "СчетКонтрагента", XMLСтрока(Объект.СчетКонтрагента));
	КонецЕсли;
	УстановитьДанные(ДанныеXDTO, "ДокументОснование", СсылкаДХ(Объект.ДокументОснование));
	УстановитьДанные(ДанныеXDTO, "Аналитика", СсылкаДХ(Объект.Аналитика));
