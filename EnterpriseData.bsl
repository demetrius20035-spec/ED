		ИсправляемыйДокументПоступления.КорректировкаПоступленияСсылка = КлючевоеСвойство_КорректировкаПоступленияТоваров;
		ДанныеXDTO.ИсправляемыйДокументПоступления = ИсправляемыйДокументПоступления;
		
		#КонецОбласти
		
		#Область ВидОперации
		ДанныеXDTO.ВидОперации = "СогласованноеИзменение";
		#КонецОбласти
		
		#Область ОтражатьВУчете
		ДанныеXDTO.ОтражатьВУчете = Истина;
		#КонецОбласти
		
		#Область ДатаИсправления
		ДанныеXDTO.ДатаИсправления 			= Документ.Дата;
		#КонецОбласти
		
		#Область НомерИсправления
		ДанныеXDTO.НомерИсправления			= Документ.Номер;
		#КонецОбласти
		
		#Область ТоварыПРОВЕРИТЬ
		
		СтрокиТоварыXDTO = СоздатьЗначениеXDTO("Документ.КорректировкаПоступленияТоваров.Товары");
		
		ИндексСтроки = 0;
		Для Каждого СтрокаТовары Из Документ.Товары Цикл
			
			Если СтрокаТовары.СуммаДоИзменения = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ДанныеXDTOСтрокаТовары = СоздатьЗначениеXDTO("Документ.КорректировкаПоступленияТоваров.Товары.Строка");  
			ДанныеXDTOСтрокаТовары.НомерСтрокиДокумента = ИндексСтроки;
			ДанныеXDTOСтрокаТовары.ДанныеНоменклатуры = СоздатьЗначениеXDTO("ОбщиеСвойстваДанныеНоменклатуры");
			ДанныеXDTOСтрокаТовары.ДанныеНоменклатуры.Номенклатура = СоздатьЗначениеXDTO("КлючевыеСвойстваНоменклатура");
			
			ДанныеXDTOСтрокаТовары.ДанныеНоменклатуры.Номенклатура.Ссылка =   "" + СтрокаТовары.Номенклатура.Ссылка.УникальныйИдентификатор();
			ДанныеXDTOСтрокаТовары.ДанныеНоменклатуры.Номенклатура.НаименованиеПолное = Строка(СтрокаТовары.Номенклатура);
			ДанныеXDTOСтрокаТовары.ДанныеНоменклатуры.Номенклатура.КодВПрограмме = "";
			ДанныеXDTOСтрокаТовары.ДанныеНоменклатуры.Номенклатура.Артикул = СтрокаТовары.Номенклатура.Артикул;
			ДанныеXDTOСтрокаТовары.ДанныеНоменклатуры.Номенклатура.Наименование = Строка(СтрокаТовары.Номенклатура);
			
			КлючевыеСвойства_НоменклатураГруппа = СоздатьЗначениеXDTO("КлючевыеСвойстваНоменклатураГруппа"); 
			КлючевыеСвойства_НоменклатураГруппа.Ссылка = "" + СтрокаТовары.Номенклатура.НоменклатурнаяГруппа.УникальныйИдентификатор();
			КлючевыеСвойства_НоменклатураГруппа.Наименование =  Строка(СтрокаТовары.Номенклатура.НоменклатурнаяГруппа);
			ДанныеXDTOСтрокаТовары.ДанныеНоменклатуры.Номенклатура.Группа =  КлючевыеСвойства_НоменклатураГруппа;
			
			ДанныеXDTOСтрокаТовары.Количество = СтрокаТовары.Количество;
			ДанныеXDTOСтрокаТовары.КоличествоДоИзменения = СтрокаТовары.КоличествоДоИзменения;
			ДанныеXDTOСтрокаТовары.КоличествоДоКорректировки = СтрокаТовары.КоличествоДоКорректировки;
			ДанныеXDTOСтрокаТовары.Сумма = СтрокаТовары.Сумма; // ??
			ДанныеXDTOСтрокаТовары.СуммаДоИзменения = СтрокаТовары.СуммаДоИзменения;
			ДанныеXDTOСтрокаТовары.СуммаДоКорректировки = СтрокаТовары.СуммаДоКорректировки; 
			ДанныеXDTOСтрокаТовары.Цена = СтрокаТовары.Цена;
			ДанныеXDTOСтрокаТовары.ЦенаДоИзменения = СтрокаТовары.ЦенаДоИзменения;
			ДанныеXDTOСтрокаТовары.ЦенаДоКорректировки = СтрокаТовары.ЦенаДоКорректировки;
			
			СтавкаНДС = ПолучитьСтавкуНДС(СтрокаТовары.СтавкаНДС);
			Если СтавкаНДС <> Неопределено Тогда
				Если СтрокаТовары.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС0 Тогда
					ДанныеXDTOСтрокаТовары.СтавкаНДС = "НДС0";
				ИначеЕсли СтрокаТовары.СтавкаНДС = Справочники.СтавкиНДС.ЛьготнаяСтавкаНДС10 Тогда 
					ДанныеXDTOСтрокаТовары.СтавкаНДС = "НДС10";
				ИначеЕсли СтрокаТовары.СтавкаНДС = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС18 Тогда 
					ДанныеXDTOСтрокаТовары.СтавкаНДС = "НДС18";
				ИначеЕсли СтрокаТовары.СтавкаНДС = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС20 Тогда
					ДанныеXDTOСтрокаТовары.СтавкаНДС = "НДС20";
				ИначеЕсли СтрокаТовары.СтавкаНДС = Справочники.СтавкиНДС.ЛьготнаяСтавкаНДС5 Тогда
					ДанныеXDTOСтрокаТовары.СтавкаНДС = "НДС10";
				ИначеЕсли СтрокаТовары.СтавкаНДС = Справочники.СтавкиНДС.БезНДС Тогда	
					ДанныеXDTOСтрокаТовары.СтавкаНДС = "БезНДС";
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаТовары.СтавкаНДСДоИзменения) Тогда 
				Если  СтрокаТовары.СтавкаНДСДоИзменения = Справочники.СтавкиНДС.СтавкаНДС0 Тогда
					ДанныеXDTOСтрокаТовары.СтавкаНДСДоИзменения = "НДС0";
				ИначеЕсли СтрокаТовары.СтавкаНДСДоИзменения = Справочники.СтавкиНДС.ЛьготнаяСтавкаНДС10 Тогда 
					ДанныеXDTOСтрокаТовары.СтавкаНДСДоИзменения = "НДС10";
				ИначеЕсли СтрокаТовары.СтавкаНДСДоИзменения = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС18 Тогда 
					ДанныеXDTOСтрокаТовары.СтавкаНДСДоИзменения = "НДС18";
				ИначеЕсли СтрокаТовары.СтавкаНДСДоИзменения = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС20 Тогда
					ДанныеXDTOСтрокаТовары.СтавкаНДСДоИзменения = "НДС20";
				ИначеЕсли СтрокаТовары.СтавкаНДСДоИзменения = Справочники.СтавкиНДС.ЛьготнаяСтавкаНДС5 Тогда
					ДанныеXDTOСтрокаТовары.СтавкаНДСДоИзменения = "НДС10";
				ИначеЕсли СтрокаТовары.СтавкаНДСДоИзменения = Справочники.СтавкиНДС.БезНДС Тогда	
					ДанныеXDTOСтрокаТовары.СтавкаНДСДоИзменения = "БезНДС";
				КонецЕсли;
			КонецЕсли;
			
			ДанныеXDTOСтрокаТовары.СуммаНДС = СтрокаТовары.СуммаНДС;
			ДанныеXDTOСтрокаТовары.СуммаНДСДоКорректировки = СтрокаТовары.СуммаНДСДоКорректировки;
			ДанныеXDTOСтрокаТовары.СуммаНДСДоИзменения = СтрокаТовары.СуммаНДСДоИзменения;
			
			ДанныеXDTOСтрокаТовары.ЕстьВДокументеПоступленияРеализации = Истина;
			
			СтрокиТоварыXDTO.Строка.Добавить(ДанныеXDTOСтрокаТовары);
			
			//Много позиций пропустили
			
			ИндексСтроки = ИндексСтроки + 1;
			
		КонецЦикла;
		
		УстановитьДанные(ДанныеXDTO, "Товары", СтрокиТоварыXDTO);
		#КонецОбласти
		
		#Область УслугиПРОВЕРИТЬ
		СтрокиУслугиXDTO = СоздатьЗначениеXDTO("Документ.КорректировкаПоступленияТоваров.Услуги");
		
		ИндексСтроки = 0;
		Для Каждого СтрокаУслуги Из Документ.Услуги Цикл
			Если СтрокаУслуги.СуммаДоИзменения = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ДанныеXDTOСтрокаУслуги = СоздатьЗначениеXDTO("Документ.КорректировкаПоступленияТоваров.Услуги.Строка");       
			//ДанныеXDTOСтрокаУслуги.НомерСтрокиДокумента = ИндексСтроки; 
			
			КлючевыеСвойства_Номенклатура = СоздатьЗначениеXDTO("КлючевыеСвойстваНоменклатура");
			КлючевыеСвойства_Номенклатура.Ссылка =   "" + СтрокаУслуги.Номенклатура.Ссылка.УникальныйИдентификатор();
			КлючевыеСвойства_Номенклатура.НаименованиеПолное = Строка(СтрокаУслуги.Номенклатура);
			КлючевыеСвойства_Номенклатура.КодВПрограмме = "";
			//КлючевыеСвойства_Номенклатура.Артикул = СтрокаУслуги.Номенклатура.Артикул;
			КлючевыеСвойства_Номенклатура.Наименование = Строка(СтрокаУслуги.Номенклатура);
			
			КлючевыеСвойства_НоменклатураГруппа = СоздатьЗначениеXDTO("КлючевыеСвойстваНоменклатураГруппа"); 
			КлючевыеСвойства_НоменклатураГруппа.Ссылка = "" + СтрокаУслуги.Номенклатура.Родитель.УникальныйИдентификатор();
			КлючевыеСвойства_НоменклатураГруппа.Наименование =  Строка(СтрокаУслуги.Номенклатура.Родитель.Наименование);
			КлючевыеСвойства_НоменклатураГруппа.КодВПрограмме =  Строка(СтрокаУслуги.Номенклатура.Родитель.Код);
			КлючевыеСвойства_Номенклатура.Группа =  КлючевыеСвойства_НоменклатураГруппа;
			
			ДанныеXDTOСтрокаУслуги.Номенклатура = КлючевыеСвойства_Номенклатура;
			
			//ДанныеXDTOСтрокаУслуги.Номенклатура = ПолучитьКлючевоеСвойство(СтрокаУслуги.Номенклатура, ФайлОбмена, КЭШ, Документ);        
			
			ДанныеXDTOСтрокаУслуги.Количество = СтрокаУслуги.Количество;
			ДанныеXDTOСтрокаУслуги.КоличествоДоКорректировки = СтрокаУслуги.КоличествоДоКорректировки;
			ДанныеXDTOСтрокаУслуги.КоличествоДоИзменения = СтрокаУслуги.КоличествоДоИзменения;
			ДанныеXDTOСтрокаУслуги.Сумма = СтрокаУслуги.Сумма;
			ДанныеXDTOСтрокаУслуги.СуммаДоИзменения = СтрокаУслуги.СуммаДоИзменения;
			ДанныеXDTOСтрокаУслуги.СуммаДоКорректировки = СтрокаУслуги.СуммаДоКорректировки;
			ДанныеXDTOСтрокаУслуги.Цена = СтрокаУслуги.Цена;
			ДанныеXDTOСтрокаУслуги.ЦенаДоИзменения = СтрокаУслуги.ЦенаДоИзменения;
			ДанныеXDTOСтрокаУслуги.ЦенаДоКорректировки = СтрокаУслуги.ЦенаДоКорректировки;
			СтавкаНДС = ПолучитьСтавкуНДС(СтрокаУслуги.СтавкаНДС);
			Если СтавкаНДС <> Неопределено Тогда
				ДанныеXDTOСтрокаУслуги.СтавкаНДС = СтавкаНДС;
				ДанныеXDTOСтрокаУслуги.СтавкаНДСДоИзменения = СтавкаНДС;
			КонецЕсли;
			
			ДанныеXDTOСтрокаУслуги.СуммаНДС = СтрокаУслуги.СуммаНДС;
			ДанныеXDTOСтрокаУслуги.СуммаНДСДоИзменения = СтрокаУслуги.СуммаНДСДоИзменения;
			ДанныеXDTOСтрокаУслуги.СуммаНДСДоКорректировки = СтрокаУслуги.СуммаНДСДоКорректировки;
			
			Если Документ.ДоговорКонтрагента.ПечатныеФормыБезПроектов Тогда
				ДанныеXDTOСтрокаУслуги.Содержание = СтрокаУслуги.Содержание;
				ДанныеXDTOСтрокаУслуги.СодержаниеДоИзменения = СтрокаУслуги.СодержаниеДоИзменения;
			Иначе
				ДанныеXDTOСтрокаУслуги.Содержание = СтрокаУслуги.Содержание+" "+СтрокаУслуги.Проект;
				ДанныеXDTOСтрокаУслуги.СодержаниеДоИзменения = СтрокаУслуги.СодержаниеДоИзменения+" "+СтрокаУслуги.Проект;
			КонецЕсли;
			
			ДанныеXDTOСтрокаУслуги.ЕстьВДокументеПоступленияРеализации = Истина;
			
			СтрокиУслугиXDTO.Строка.Добавить(ДанныеXDTOСтрокаУслуги);
			
			ИндексСтроки = ИндексСтроки + 1;
			
		КонецЦикла;
		
		УстановитьДанные(ДанныеXDTO, "Услуги", СтрокиУслугиXDTO);
		#КонецОбласти
		
		#Область Налогообложение
		
		Если ЗначениеЗаполнено(Документ.УчитыватьНДС) И Документ.УчитыватьНДС = ИСТИНА Тогда
			ДанныеXDTO.Налогообложение			= "ОблагаетсяНДС";
		ИначеЕсли ЗначениеЗаполнено(Документ.УчитыватьНДС) И Документ.УчитыватьНДС = ЛОЖЬ Тогда 
			ДанныеXDTO.Налогообложение			= "НеОблагаетсяНДС";
		КонецЕсли;
		
		Возврат ДанныеXDTO;
		
		#КонецОбласти
		
		#КонецОбласти
		
	КонецЕсли;
КонецФункции // ПолучитьДанные_КорректировкаДолга()

Функция ПолучитьДанные_ПоступлениеТоваровУслуг(Документ, ФайлОбмена, КЭШ)
	
	// Валюта
	ВалютаРегламентированногоУчета = ПараметрыСеанса.ВалютаРегламентированногоУчета;
	КлючевоеСвойство_Валюта = ПолучитьКлючевоеСвойство(ВалютаРегламентированногоУчета, ФайлОбмена, КЭШ, Документ);
	
	// Организация
	Организация = Документ.Организация;
	КлючевоеСвойство_Организация = ПолучитьКлючевоеСвойство(Организация, ФайлОбмена, КЭШ, Документ);
	
	// Контаргент
	Контрагент = Документ.Контрагент;
	КлючевоеСвойство_Контрагент = ПолучитьКлючевоеСвойство(Контрагент, ФайлОбмена, КЭШ, Документ);
	
	// ДанныеВходящегоДокумента
	ДанныеВходящегоДокумента =  СоздатьЗначениеXDTO("ОбщиеСвойстваДанныеВходящегоДокумента");
	ДанныеВходящегоДокумента.НомерВходящегоДокумента = Документ.НомерВходящегоДокумента;
	ДанныеВходящегоДокумента.ДатаВходящегоДокумента = Документ.ДатаВходящегоДокумента;
	ДанныеВходящегоДокумента.НаименованиеВходящегоДокумента = Строка(Документ);
	
	
	// Ключевое свойство - Поступление товаров услуг
	КлючевоеСвойство_Документа = СоздатьЗначениеXDTO("КлючевыеСвойстваПоступлениеТоваровУслуг");
	КлючевоеСвойство_Документа.Ссылка		= "" + Документ.УникальныйИдентификатор();
	КлючевоеСвойство_Документа.Дата			= Документ.Дата;
	КлючевоеСвойство_Документа.Номер		= Документ.Номер;
	КлючевоеСвойство_Документа.Организация	= КлючевоеСвойство_Организация;
	КлючевоеСвойство_Документа.ДанныеВходящегоДокумента			= ДанныеВходящегоДокумента;
	КлючевоеСвойство_Документа.Контрагент			= КлючевоеСвойство_Контрагент;
	
	// Ключевое ствойство - Договор
	
	Если ЗначениеЗаполнено(Документ.Контрагент.ОсновнойДоговорБухгалтерскогоУчета) Тогда
		ДоговорКонтрагента = Документ.Контрагент.ОсновнойДоговорБухгалтерскогоУчета;
	Иначе
		ДоговорКонтрагента = Документ.ДоговорКонтрагента;
	КонецЕсли;
	
	КлючевоеСвойство_Договор = ПолучитьКлючевоеСвойство(ДоговорКонтрагента, ФайлОбмена, КЭШ, Документ);
	
	
	// ДанныеВзаиморасчетов
	ДанныеВзаиморасчетов = СоздатьЗначениеXDTO("ОбщиеСвойстваДанныеВзаиморасчетов");
	ДанныеВзаиморасчетов.Договор = КлючевоеСвойство_Договор;
	ДанныеВзаиморасчетов.ВалютаВзаиморасчетов = КлючевоеСвойство_Валюта;
	ДанныеВзаиморасчетов.КурсВзаиморасчетов = 1;
	ДанныеВзаиморасчетов.КратностьВзаиморасчетов = 1;
	ДанныеВзаиморасчетов.РасчетыВУсловныхЕдиницах = Ложь;
	// ДанныеВзаиморасчетов.СчетУчетаРасчетовСКонтрагентом = "";
	// ДанныеВзаиморасчетов.СчетУчетаРасчетовПоАвансам = "";
	
	
	
	
	// ДанныеXDTO - Реализация товаров услуг
	ДанныеXDTO = СоздатьЗначениеXDTO("Документ.ПоступлениеТоваровУслуг");
	ДанныеXDTO.КлючевыеСвойства 	= КлючевоеСвойство_Документа;
	
	
	// Товары
	
	СтрокиТоварыXDTO = СоздатьЗначениеXDTO("Документ.ПоступлениеТоваровУслуг.Товары");
	
	ИндексСтроки = 0;
	Для Каждого СтрокаТовары Из Документ.Товары Цикл
		
		ДанныеНоменклатуры = СоздатьЗначениеXDTO("ОбщиеСвойстваДанныеНоменклатуры");
		ДанныеНоменклатуры.Номенклатура = ПолучитьКлючевоеСвойство(СтрокаТовары.Номенклатура, ФайлОбмена, КЭШ, Документ);
		
		ДанныеXDTOСтрокаТовары = СоздатьЗначениеXDTO("Документ.ПоступлениеТоваровУслуг.Товары.Строка");
		ДанныеXDTOСтрокаТовары.НомерСтрокиДокумента = ИндексСтроки;
		ДанныеXDTOСтрокаТовары.ДанныеНоменклатуры = ДанныеНоменклатуры;
		
		ЕдиницаИзмерения = СтрокаТовары.Единица.Единица;
		ДанныеXDTOСтрокаТовары.ЕдиницаИзмерения = ПолучитьКлючевоеСвойство(ЕдиницаИзмерения, ФайлОбмена, КЭШ, Документ);
		
		ДанныеXDTOСтрокаТовары.Количество = СтрокаТовары.Количество;
		ДанныеXDTOСтрокаТовары.Сумма = СтрокаТовары.Всего;
		ДанныеXDTOСтрокаТовары.Цена = СтрокаТовары.Цена;
		
		ТипXDTO = ФабрикаXDTO.Тип(URI(), "СтавкиНДС");
		СтавкаНДС18 = ФабрикаXDTO.Создать(ТипXDTO, "БезНДС");
		
		ДанныеXDTOСтрокаТовары.СтавкаНДС = СтавкаНДС18;
		
		ДанныеXDTOСтрокаТовары.СуммаНДС = СтрокаТовары.СуммаНДС;
		
		
		СтрокиТоварыXDTO.Строка.Добавить(ДанныеXDTOСтрокаТовары);
		
		ИндексСтроки = ИндексСтроки + 1;
		
	КонецЦикла;
	
	УстановитьДанные(ДанныеXDTO, "Товары", СтрокиТоварыXDTO);
	
	// Услуги
	
	СтрокиТоварыXDTO = СоздатьЗначениеXDTO("Документ.ПоступлениеТоваровУслуг.Услуги");
	
	ИндексСтроки = 0;
	Для Каждого СтрокаТовары Из Документ.Услуги Цикл
		
		ДанныеXDTOСтрокаУслуги = СоздатьЗначениеXDTO("Документ.ПоступлениеТоваровУслуг.Услуги.Строка");
		ДанныеXDTOСтрокаУслуги.НомерСтрокиДокумента = ИндексСтроки;
		
		Если ЗначениеЗаполнено(СтрокаТовары.Номенклатура) Тогда
			ДанныеXDTOСтрокаУслуги.Номенклатура = ПолучитьКлючевоеСвойство(СтрокаТовары.Номенклатура, ФайлОбмена, КЭШ, Документ);
		КонецЕсли;
		
		ДанныеXDTOСтрокаУслуги.Количество = СтрокаТовары.Количество;
		ДанныеXDTOСтрокаУслуги.Сумма = СтрокаТовары.Всего;
		ДанныеXDTOСтрокаУслуги.Цена = СтрокаТовары.Цена;
		ДанныеXDTOСтрокаУслуги.Содержание = СтрокаТовары.Содержание;
		
		
		СтрокиТоварыXDTO.Строка.Добавить(ДанныеXDTOСтрокаУслуги);
		
		ИндексСтроки = ИндексСтроки + 1;
		
	КонецЦикла;
	
	УстановитьДанные(ДанныеXDTO, "Услуги", СтрокиТоварыXDTO);
	
	// Лицензии
	
	СтрокиТоварыXDTO = СоздатьЗначениеXDTO("Документ.ПоступлениеТоваровУслуг.Услуги");
	
	//ИндексСтроки = 0;
	Для Каждого СтрокаТовары Из Документ.Лицензии Цикл
		
		ДанныеXDTOСтрокаУслуги = СоздатьЗначениеXDTO("Документ.ПоступлениеТоваровУслуг.Услуги.Строка");
		ДанныеXDTOСтрокаУслуги.НомерСтрокиДокумента = ИндексСтроки;
		
		Если ЗначениеЗаполнено(СтрокаТовары.Номенклатура) Тогда
			ДанныеXDTOСтрокаУслуги.Номенклатура = ПолучитьКлючевоеСвойство(СтрокаТовары.Номенклатура, ФайлОбмена, КЭШ, Документ);
		КонецЕсли;
		
		ДанныеXDTOСтрокаУслуги.Количество = СтрокаТовары.Количество;
		ДанныеXDTOСтрокаУслуги.Сумма = СтрокаТовары.Всего;
		ДанныеXDTOСтрокаУслуги.Цена = СтрокаТовары.Цена;
		ДанныеXDTOСтрокаУслуги.Содержание = СтрокаТовары.Содержание;
		
		
		СтрокиТоварыXDTO.Строка.Добавить(ДанныеXDTOСтрокаУслуги);
		
		ИндексСтроки = ИндексСтроки + 1;
		
	КонецЦикла;
	
	УстановитьДанные(ДанныеXDTO, "Услуги", СтрокиТоварыXDTO);
	
	ДанныеXDTO.Валюта				= КлючевоеСвойство_Валюта;
	ДанныеXDTO.ВидОперации			= "ПокупкаУПоставщика";
	ДанныеXDTO.Сумма				= Документ.Всего;
	// ДанныеXDTO.СуммаВключаетНДС		= Документ.СуммаВключаетНДС;
	ДанныеXDTO.СуммаВключаетНДС		= Истина;
	УстановитьДанные(ДанныеXDTO, "Склад", ПолучитьКлючевоеСвойство(Документ.Склад, ФайлОбмена, КЭШ, Документ));
	//	ДанныеXDTO.Контрагент			= КлючевоеСвойство_Контрагент;
	ДанныеXDTO.ДанныеВзаиморасчетов = ДанныеВзаиморасчетов;
	
	УстановитьДанные(ДанныеXDTO, "Комментарий", "Комментарий");
	
	
	
	Возврат ДанныеXDTO;
	
КонецФункции // ПолучитьДанные_ПоступлениеТоваровУслуг()

Функция ПолучитьДанные_АвансовыйОтчет(ДокументСсылка, ФайлОбмена, КЭШ)
	
	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	
	// ========================================================================
	// ДанныеXDTO - создаем сначала, потом заполняем
	// ========================================================================
	ДанныеXDTO = СоздатьЗначениеXDTO("Документ.АвансовыйОтчет");
	
	// ========================================================================
	// Подготовка ключевых свойств
	// ========================================================================
	
	// Валюта
	Валюта = ДокументОбъект.Валюта;
	КлючевоеСвойство_Валюта = ПолучитьКлючевоеСвойство(Валюта, ФайлОбмена, КЭШ, ДокументОбъект);
	
	// Организация
	Организация = ДокументОбъект.Организация;
	КлючевоеСвойство_Организация = ПолучитьКлючевоеСвойство(Организация, ФайлОбмена, КЭШ, ДокументОбъект);
	
	// Подразделение (если есть)
	КлючевоеСвойство_Подразделение = Неопределено;
	Если ЗначениеЗаполнено(ДокументОбъект.Подразделение) Тогда
		КлючевоеСвойство_Подразделение = ПолучитьКлючевоеСвойство(ДокументОбъект.Подразделение, ФайлОбмена, КЭШ, ДокументОбъект);
	КонецЕсли;
	
	// Ответственный (сотрудник)
	КлючевоеСвойство_Ответственный = Неопределено;
	Если ЗначениеЗаполнено(ДокументОбъект.Ответственный) Тогда
		КлючевоеСвойство_Ответственный = ПолучитьКлючевоеСвойство(ДокументОбъект.Ответственный, ФайлОбмена, КЭШ, ДокументОбъект);
	КонецЕсли;
	
	// Склад
	КлючевоеСвойство_Склад = Неопределено;
	Если ЗначениеЗаполнено(ДокументОбъект.Склад) Тогда
		КлючевоеСвойство_Склад = ПолучитьКлючевоеСвойство(ДокументОбъект.Склад, ФайлОбмена, КЭШ, ДокументОбъект);
	КонецЕсли;
	
	// Подотчетное лицо (ФизическоеЛицо)
	КлючевоеСвойство_ПодотчетноеЛицо = Неопределено;
	Если ЗначениеЗаполнено(ДокументОбъект.ФизическоеЛицо) Тогда
		КлючевоеСвойство_ПодотчетноеЛицо = ПолучитьКлючевоеСвойство(ДокументОбъект.ФизическоеЛицо, ФайлОбмена, КЭШ, ДокументОбъект);
	КонецЕсли;
	
	// ========================================================================
	// Ключевое свойство документа
	// ========================================================================
	КлючевоеСвойство_Документа = СоздатьЗначениеXDTO("КлючевыеСвойстваАвансовыйОтчет");
	КлючевоеСвойство_Документа.Ссылка = "" + ДокументОбъект.Ссылка.УникальныйИдентификатор();
	КлючевоеСвойство_Документа.Дата = ДокументОбъект.Дата;
	КлючевоеСвойство_Документа.Номер = ДокументОбъект.Номер;
	КлючевоеСвойство_Документа.Организация = КлючевоеСвойство_Организация;
	
	// ========================================================================
	// Заполнение реквизитов шапки
	// ========================================================================
	ДанныеXDTO.КлючевыеСвойства = КлючевоеСвойство_Документа;
	
	// Ответственный
	Если КлючевоеСвойство_Ответственный <> Неопределено Тогда
		ДанныеXDTO.Ответственный = КлючевоеСвойство_Ответственный;
	КонецЕсли;
	
	ДанныеXDTO.Валюта = КлючевоеСвойство_Валюта;
	ДанныеXDTO.Сумма = ДокументОбъект.Всего;
	ДанныеXDTO.СуммаВключаетНДС = ДокументОбъект.СуммаВключаетНДС;
	ДанныеXDTO.КурсДокумента = ДокументОбъект.КурсВзаиморасчетов;
	ДанныеXDTO.КратностьДокумента = ДокументОбъект.КратностьВзаиморасчетов;
	
	// ПодотчетноеЛицо
	Если КлючевоеСвойство_ПодотчетноеЛицо <> Неопределено Тогда
		ДанныеXDTO.ПодотчетноеЛицо = КлючевоеСвойство_ПодотчетноеЛицо;
	КонецЕсли;
	
	// Склад
	Если КлючевоеСвойство_Склад <> Неопределено Тогда
		ДанныеXDTO.Склад = КлючевоеСвойство_Склад;
	КонецЕсли;
	
	// КоличествоДокументов
	//Если ЗначениеЗаполнено(ДокументОбъект.КоличествоДокументов) Тогда
	//	ДанныеXDTO.КоличествоДокументов = Строка(ДокументОбъект.КоличествоДокументов);
	//КонецЕсли;
	
	// КоличествоЛистов
	//Если ЗначениеЗаполнено(ДокументОбъект.КоличествоЛистов) Тогда
	//	ДанныеXDTO.КоличествоЛистов = Строка(ДокументОбъект.КоличествоЛистов);
	//КонецЕсли;
	
	// Подразделение
	Если КлючевоеСвойство_Подразделение <> Неопределено Тогда
		ДанныеXDTO.Подразделение = КлючевоеСвойство_Подразделение;
	КонецЕсли;
	
	// Комментарий
	ДанныеXDTO.Комментарий = ДокументОбъект.Комментарий;
	
	#Область Стало
	// ========================================================================
	// Табличная часть 1: ВыданныеАвансы
	// ========================================================================
	Если ДокументОбъект.ВыданныеАвансы.Количество() > 0 Тогда
		ВыданныеАвансыXDTO = СоздатьЗначениеXDTO("Документ.АвансовыйОтчет.ВыданныеАвансы");
		
		// Получаем тип строки заранее, чтобы взять из него тип свойства "Документ"
		ТипСтроки = ФабрикаXDTO.Тип(URI(), "Документ.АвансовыйОтчет.ВыданныеАвансы.Строка");
		СвойствоДокумент = ТипСтроки.Свойства.Получить("Документ");
		Если СвойствоДокумент = Неопределено Тогда
			ВызватьИсключение "Не найдено свойство 'Документ' в типе строки выданных авансов";
		КонецЕсли;
		ТипОснования = СвойствоДокумент.Тип;
		
		Для Каждого Строка Из ДокументОбъект.ВыданныеАвансы Цикл
			СтрокаXDTO = СоздатьЗначениеXDTO("Документ.АвансовыйОтчет.ВыданныеАвансы.Строка");
			
			// Документ-основание аванса
			Если ЗначениеЗаполнено(Строка.ДокументАванса) Тогда
				КлючСвойства = ПолучитьКлючевоеСвойство(Строка.ДокументАванса, ФайлОбмена, КЭШ, ДокументОбъект);
				
				Если КлючСвойства <> Неопределено Тогда
					ДокументАвансаXDTO = ФабрикаXDTO.Создать(ТипОснования);
					ТипДокумента = ТипЗнч(Строка.ДокументАванса);
					
					// Флаг, что ссылка успешно установлена
					СсылкаУстановлена = Ложь;
					
					Если ТипДокумента = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
						ДокументАвансаXDTO.РасходныйКассовыйОрдерСсылка = КлючСвойства;
						СсылкаУстановлена = Истина;
					ИначеЕсли ТипДокумента = Тип("ДокументСсылка.СписаниеСРасчетногоСчета") Тогда
						ДокументАвансаXDTO.СписаниеБезналичныхДенежныхСредствСсылка = КлючСвойства;
						СсылкаУстановлена = Истина;
					ИначеЕсли ТипДокумента = Тип("ДокументСсылка.АвансовыйОтчет") Тогда
						ДокументАвансаXDTO.АвансовыйОтчетСсылка = КлючСвойства;
						СсылкаУстановлена = Истина;
					КонецЕсли;
					
					Если СсылкаУстановлена Тогда
						СтрокаXDTO.Документ = ДокументАвансаXDTO;
						СтрокаXDTO.Сумма = Строка.Сумма;               // Сумма заполняется ТОЛЬКО тут
						ВыданныеАвансыXDTO.Строка.Добавить(СтрокаXDTO); // Добавляем только валидную строку
					Иначе
						Сообщить("Неподдерживаемый тип документа-основания: " + ТипДокумента);
					КонецЕсли;
				Иначе
					Сообщить("Не удалось получить ключевые свойства для документа: " + Строка(Строка.ДокументАванса));
				КонецЕсли;
			КонецЕсли; // ЗначениеЗаполнено(Строка.ДокументАванса)
		КонецЦикла;
		
		// Если после обработки есть хотя бы одна строка – добавляем секцию ВыданныеАвансы
		Если ВыданныеАвансыXDTO.Строка.Количество() > 0 Тогда
			УстановитьДанные(ДанныеXDTO, "ВыданныеАвансы", ВыданныеАвансыXDTO);
		КонецЕсли;
	КонецЕсли;
	#КонецОбласти
	
	// ========================================================================
	// Табличная часть 2: ОплатаКонтрагентам
	// ========================================================================
	Если ДокументОбъект.ОплатаПоставщикам.Количество() > 0 Тогда
		ОплатаКонтрагентамXDTO = СоздатьЗначениеXDTO("Документ.АвансовыйОтчет.ОплатаКонтрагентам");
		
		Для Каждого Строка Из ДокументОбъект.ОплатаПоставщикам Цикл
			СтрокаXDTO = СоздатьЗначениеXDTO("Документ.АвансовыйОтчет.ОплатаКонтрагентам.Строка");
			
			// Контрагент
			Если ЗначениеЗаполнено(Строка.Контрагент) Тогда
				СтрокаXDTO.Контрагент = ПолучитьКлючевоеСвойство(Строка.Контрагент, ФайлОбмена, КЭШ, ДокументОбъект);
			КонецЕсли;
			
			// ДанныеВзаиморасчетов
			ДанныеВзаиморасчетов = СоздатьЗначениеXDTO("ОбщиеСвойстваДанныеВзаиморасчетов");
			Если ЗначениеЗаполнено(Строка.ДоговорКонтрагента) Тогда
				ДанныеВзаиморасчетов.Договор = ПолучитьКлючевоеСвойство(Строка.ДоговорКонтрагента, ФайлОбмена, КЭШ, ДокументОбъект);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Строка.Валюта) Тогда
				ДанныеВзаиморасчетов.ВалютаВзаиморасчетов = ПолучитьКлючевоеСвойство(Строка.Валюта, ФайлОбмена, КЭШ, ДокументОбъект);
			КонецЕсли;
			
			ДанныеВзаиморасчетов.КурсВзаиморасчетов = Строка.КурсВзаиморасчетов;
			ДанныеВзаиморасчетов.КратностьВзаиморасчетов = Строка.КратностьВзаиморасчетов;
			СтрокаXDTO.ДанныеВзаиморасчетов = ДанныеВзаиморасчетов;
			
			СтрокаXDTO.Содержание = Строка.Комментарий;
			СтрокаXDTO.Сумма = Строка.Сумма;
			СтрокаXDTO.СуммаВзаиморасчетов = Строка.СуммаВзаиморасчетов;
			
			// ДанныеВходящегоДокумента (если есть)
			Если ЗначениеЗаполнено(Строка.Номер) ИЛИ ЗначениеЗаполнено(Строка.Дата) Тогда
				ДанныеВходящегоДокумента = СоздатьЗначениеXDTO("ОбщиеСвойстваДанныеВходящегоДокумента");
				ДанныеВходящегоДокумента.НомерВходящегоДокумента = Строка.Номер;
				ДанныеВходящегоДокумента.ДатаВходящегоДокумента = Строка.Дата;
				СтрокаXDTO.ДанныеВходящегоДокумента = ДанныеВходящегоДокумента;
			КонецЕсли;
			
			// ДокументРасчетов (если есть)
			Если ЗначениеЗаполнено(Строка.КредитовыйДокумент) Тогда
				КлючСвойства = ПолучитьКлючевоеСвойство(Строка.КредитовыйДокумент, ФайлОбмена, КЭШ, ДокументОбъект);
				
				Если КлючСвойства <> Неопределено Тогда
					// Получаем тип для ДокументРасчетов из метаданных строки (динамически)
					ТипСтрокиОплаты = ФабрикаXDTO.Тип(URI(), "Документ.АвансовыйОтчет.ОплатаКонтрагентам.Строка");
					СвойствоДокРасчетов = ТипСтрокиОплаты.Свойства.Получить("ДокументРасчетов");
					Если СвойствоДокРасчетов <> Неопределено Тогда
						ТипДокументаРасчетов = СвойствоДокРасчетов.Тип;
						ДокументРасчетов = ФабрикаXDTO.Создать(ТипДокументаРасчетов);
						
						ТипДокумента = ТипЗнч(Строка.КредитовыйДокумент);
						Если ТипДокумента = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
							ДокументРасчетов.ПоступлениеТоваровУслугСсылка = КлючСвойства;
						ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
							ДокументРасчетов.РеализацияТоваровУслугСсылка = КлючСвойства;
						КонецЕсли;
						
						СтрокаXDTO.ДокументРасчетов = ДокументРасчетов;
					КонецЕсли;
				Иначе
					// Ключевые свойства не получены – пропускаем
					Сообщить("Пропущен кредитовый документ: " + Строка(Строка.КредитовыйДокумент));
				КонецЕсли;
			КонецЕсли;
			
			ОплатаКонтрагентамXDTO.Строка.Добавить(СтрокаXDTO);
		КонецЦикла;
		
		УстановитьДанные(ДанныеXDTO, "ОплатаКонтрагентам", ОплатаКонтрагентамXDTO);
	КонецЕсли;
	
	
	
	#Область Товары
	// ========================================================================
	// Табличная часть 3: Товары (минимальный набор полей, как в эталонном XML)
	// ========================================================================
	Если ДокументОбъект.ЗакупкаТовара.Количество() > 0 Тогда
		ТоварыXDTO = СоздатьЗначениеXDTO("Документ.АвансовыйОтчет.Товары");
		
		ИндексСтроки = 0;
		Для Каждого Строка Из ДокументОбъект.ЗакупкаТовара Цикл
			СтрокаXDTO = СоздатьЗначениеXDTO("Документ.АвансовыйОтчет.Товары.Строка");
			
			// 1. ДанныеНоменклатуры
			ДанныеНоменклатуры = СоздатьЗначениеXDTO("ОбщиеСвойстваДанныеНоменклатуры");
			ДанныеНоменклатуры.Номенклатура = ПолучитьКлючевоеСвойство(Строка.Номенклатура, ФайлОбмена, КЭШ, ДокументОбъект);
			Если ЗначениеЗаполнено(Строка.Характеристика) Тогда
				ДанныеНоменклатуры.Характеристика = ПолучитьКлючевоеСвойство(Строка.Характеристика, ФайлОбмена, КЭШ, ДокументОбъект);
			КонецЕсли;
			СтрокаXDTO.ДанныеНоменклатуры = ДанныеНоменклатуры;
			
			// 2. ЕдиницаИзмерения
			ЕдиницаСсылка = ?(ЗначениеЗаполнено(Строка.Единица), Строка.Единица, Строка.Номенклатура.БазоваяЕдиницаПоКлассификатору);
			ЕдиницаИзмеренияКлюч = ПолучитьКлючевоеСвойство(ЕдиницаСсылка, ФайлОбмена, КЭШ, ДокументОбъект);
			СтрокаXDTO.ЕдиницаИзмерения = ЕдиницаИзмеренияКлюч;
			
			// 3. Количество
			СтрокаXDTO.Количество = Строка.Количество;
			
			// 4. Цена
			СтрокаXDTO.Цена = Строка.Цена;
			
			// 5. Сумма (без ЦенаЗаУпаковку)
			СтрокаXDTO.Сумма = Строка.Сумма;
			
			// 6. СтавкаНДС (если есть)
			Если ЗначениеЗаполнено(Строка.СтавкаНДС) Тогда
				ТипСтавкаНДС = ФабрикаXDTO.Тип(URI(), "СтавкиНДС");
				СтрокаXDTO.СтавкаНДС = ФабрикаXDTO.Создать(ТипСтавкаНДС, Строка.СтавкаНДС.ИмяПредопределенныхДанных);
			КонецЕсли;
			
			// 7. ТипЗапасов
			ТипЗапасов = ФабрикаXDTO.Тип(URI(), "ТипыЗапасов");
			СтрокаXDTO.ТипЗапасов = ФабрикаXDTO.Создать(ТипЗапасов, "СобственныеТовары");
			
			// 8. ПредъявленСФ
			СтрокаXDTO.ПредъявленСФ = Ложь;
			
			// 9. ЗакупкаПодДеятельность
			ТипДеятельности = ФабрикаXDTO.Тип(URI(), "ВидДеятельностиРаздельногоУчетаНДС");
			Если ЗначениеЗаполнено(Строка.СтавкаНДС) И Строка.СтавкаНДС.ИмяПредопределенныхДанных = "БезНДС" Тогда
				ЗначениеДеятельности = "НеОблагаетсяНДС";
			Иначе
				ЗначениеДеятельности = "ОблагаетсяНДС";
			КонецЕсли;
			СтрокаXDTO.ЗакупкаПодДеятельность = ФабрикаXDTO.Создать(ТипДеятельности, ЗначениеДеятельности);
			
			// 10. ДанныеВходящегоДокумента – создаём всегда, даже если нет номера/даты
			Если ЗначениеЗаполнено(Строка.Номер) ИЛИ ЗначениеЗаполнено(Строка.Дата) Тогда
				ДанныеВходящегоДокумента = СоздатьЗначениеXDTO("ОбщиеСвойстваДанныеВходящегоДокумента");
				Если ЗначениеЗаполнено(Строка.Номер) Тогда
					ДанныеВходящегоДокумента.НомерВходящегоДокумента = Строка.Номер;
				КонецЕсли;
				Если ЗначениеЗаполнено(Строка.Дата) Тогда
					ДанныеВходящегоДокумента.ДатаВходящегоДокумента = Строка.Дата;
				КонецЕсли;
				СтрокаXDTO.ДанныеВходящегоДокумента = ДанныеВходящегоДокумента;
			КонецЕсли;
			
			// Добавляем строку
			ТоварыXDTO.Строка.Добавить(СтрокаXDTO);
			ИндексСтроки = ИндексСтроки + 1;
		КонецЦикла;
		
		УстановитьДанные(ДанныеXDTO, "Товары", ТоварыXDTO);
	КонецЕсли;
	#КонецОбласти
	
	// ========================================================================
	// Табличная часть 5: ДополнительныеРеквизиты
	// ========================================================================
	Если ДокументОбъект.ДополнительныеРеквизиты.Количество() > 0 Тогда
		ДопРеквизитыXDTO = СоздатьЗначениеXDTO("ДополнительныеРеквизиты");
		
		Для Каждого Строка Из ДокументОбъект.ДополнительныеРеквизиты Цикл
			СтрокаXDTO = СоздатьЗначениеXDTO("ДополнительныеРеквизиты.Строка");
			
			СтрокаXDTO.Свойство = ПолучитьКлючевоеСвойство(Строка.Свойство, ФайлОбмена, КЭШ, ДокументОбъект);
			
			// ЗначениеСвойства
			Если ЗначениеЗаполнено(Строка.Значение) Тогда
				ЗначениеСвойства = СоздатьЗначениеXDTO("ДополнительныеРеквизиты.Строка.ЗначениеСвойства");
				ЗначениеСвойства.ЗначениеДополнительногоРеквизитаСсылка = ПолучитьКлючевоеСвойство(Строка.Значение, ФайлОбмена, КЭШ, ДокументОбъект);
				СтрокаXDTO.ЗначениеСвойства = ЗначениеСвойства;
			ИначеЕсли ЗначениеЗаполнено(Строка.ТекстоваяСтрока) Тогда
				ЗначениеСвойства = СоздатьЗначениеXDTO("ДополнительныеРеквизиты.Строка.ЗначениеСвойства");
				ЗначениеСвойства.Строка = Строка.ТекстоваяСтрока;
				СтрокаXDTO.ЗначениеСвойства = ЗначениеСвойства;
			КонецЕсли;
			
			ДопРеквизитыXDTO.Строка.Добавить(СтрокаXDTO);
		КонецЦикла;
		
		УстановитьДанные(ДанныеXDTO, "ДополнительныеРеквизиты", ДопРеквизитыXDTO);
	КонецЕсли;
	
	ТипНалогообложение = ФабрикаXDTO.Тип(URI(), "НалогообложениеНДСПродавца");
	ДанныеXDTO.НалогообложениеНДСПродавца = ФабрикаXDTO.Создать(ТипНалогообложение, "ОблагаетсяНДС");
	Возврат ДанныеXDTO;
	
КонецФункции

Функция ПолучитьДанные_СчетНаОплатуПокупателю(ДокументСсылка, ФайлОбмена, КЭШ)
	
	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	
	// ========================================================================
	// ДанныеXDTO - создаем сначала, потом заполняем
	// ========================================================================
	ДанныеXDTO = СоздатьЗначениеXDTO("Документ.СчетПокупателю");
	
	// Организация
	Организация = ДокументОбъект.Организация;
	КлючевоеСвойство_Организация = ПолучитьКлючевоеСвойство(Организация, ФайлОбмена, КЭШ, ДокументОбъект);

	// ========================================================================
	// Ключевое свойство документа
	// ========================================================================
	КлючевоеСвойство_Документа = СоздатьЗначениеXDTO("КлючевыеСвойстваСчетПокупателю");
	КлючевоеСвойство_Документа.Ссылка = "" + ДокументОбъект.Ссылка.УникальныйИдентификатор();
	КлючевоеСвойство_Документа.Дата = ДокументОбъект.Дата;
	КлючевоеСвойство_Документа.Номер = ДокументОбъект.Номер;
	КлючевоеСвойство_Документа.Организация = КлючевоеСвойство_Организация;
	
	// ========================================================================
	// Заполнение реквизитов шапки
	// ========================================================================
	ДанныеXDTO.КлючевыеСвойства = КлючевоеСвойство_Документа;
	
	// Ответственный
	Ответственный = ДокументОбъект.Ответственный;
	КлючевыеСвойство_Пользователь = ПолучитьКлючевоеСвойство(Ответственный, ФайлОбмена, КЭШ, ДокументОбъект);

	ДанныеXDTO.Ответственный = КлючевыеСвойство_Пользователь;
	
	// Услуги
	
	СтрокиТоварыXDTO = СоздатьЗначениеXDTO("Документ.СчетПокупателю.Услуги");
	
	ИндексСтроки = 0;
	Для Каждого СтрокаУслуги Из ДокументОбъект.Услуги Цикл
		
		Если СтрокаУслуги.Всего = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеXDTOСтрокаУслуги = СоздатьЗначениеXDTO("Документ.СчетПокупателю.Услуги.Строка");
		ДанныеXDTOСтрокаУслуги.НомерСтрокиДокумента = ИндексСтроки;
		ДанныеXDTOСтрокаУслуги.Номенклатура = ПолучитьКлючевоеСвойство(СтрокаУслуги.Номенклатура, ФайлОбмена, КЭШ, ДокументОбъект);
		
		ДанныеXDTOСтрокаУслуги.Количество = Окр(СтрокаУслуги.Количество, 3, РежимОкругления.Окр15как20);
		ДанныеXDTOСтрокаУслуги.Сумма = СтрокаУслуги.Всего;
		ДанныеXDTOСтрокаУслуги.Цена = ?(СтрокаУслуги.Количество=0, 0, Окр(СтрокаУслуги.Всего / СтрокаУслуги.Количество, 2, РежимОкругления.Окр15как20));
		
		СтавкаНДС = ПолучитьСтавкуНДС(СтрокаУслуги.СтавкаНДС);
		Если СтавкаНДС <> Неопределено Тогда
			ДанныеXDTOСтрокаУслуги.СтавкаНДС = СтавкаНДС;
		КонецЕсли;
		
		ДанныеXDTOСтрокаУслуги.СуммаНДС = СтрокаУслуги.СуммаНДС;
		
		ДанныеXDTOСтрокаУслуги.Содержание = СтрокаУслуги.Содержание;
		
		СтрокиТоварыXDTO.Строка.Добавить(ДанныеXDTOСтрокаУслуги);
		
		ИндексСтроки = ИндексСтроки + 1;
		
	КонецЦикла;
	
	// Лицензии
	
	Для Каждого СтрокаЛицензии Из ДокументОбъект.Лицензии Цикл
		
		Если СтрокаЛицензии.Всего = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеXDTOСтрокаУслуги = СоздатьЗначениеXDTO("Документ.СчетПокупателю.Лицензии.Строка");
		ДанныеXDTOСтрокаУслуги.НомерСтрокиДокумента = ИндексСтроки;
		ДанныеXDTOСтрокаУслуги.Номенклатура = ПолучитьКлючевоеСвойство(СтрокаЛицензии.Номенклатура, ФайлОбмена, КЭШ, ДокументОбъект);
		
		ДанныеXDTOСтрокаУслуги.Количество = Окр(СтрокаЛицензии.Количество, 3, РежимОкругления.Окр15как20);
		ДанныеXDTOСтрокаУслуги.Сумма = СтрокаЛицензии.Всего;
		ДанныеXDTOСтрокаУслуги.Цена = ?(СтрокаЛицензии.Количество=0, 0, Окр(СтрокаЛицензии.Всего / СтрокаЛицензии.Количество, 2, РежимОкругления.Окр15как20));
		
		СтавкаНДС = ПолучитьСтавкуНДС(СтрокаЛицензии.СтавкаНДС);
		Если СтавкаНДС <> Неопределено Тогда
			ДанныеXDTOСтрокаУслуги.СтавкаНДС = СтавкаНДС;
		КонецЕсли;
		
		ДанныеXDTOСтрокаУслуги.СуммаНДС = СтрокаЛицензии.СуммаНДС;
		ДанныеXDTOСтрокаУслуги.Содержание = СтрокаЛицензии.Содержание;
		
		СтрокиТоварыXDTO.Строка.Добавить(ДанныеXDTOСтрокаУслуги);
		
		ИндексСтроки = ИндексСтроки + 1;
		
	КонецЦикла;
	
	УстановитьДанные(ДанныеXDTO, "Услуги", СтрокиТоварыXDTO);	
	
	Возврат ДанныеXDTO;
	
КонецФункции

Функция ПолучитьДанные_ОтчетОРозничныхПродажах(Документ, ФайлОбмена, КЭШ)
	
	// Валюта
	ВалютаРегламентированногоУчета = ПараметрыСеанса.ВалютаРегламентированногоУчета;
	КлючевоеСвойство_Валюта = ПолучитьКлючевоеСвойство(ВалютаРегламентированногоУчета, ФайлОбмена, КЭШ, Документ);
	
	// Организация
	Организация = Документ.Организация;
	КлючевоеСвойство_Организация = ПолучитьКлючевоеСвойство(Организация, ФайлОбмена, КЭШ, Документ);
	
	// Ключевое свойство - Отчет о розничных продажах 
	КлючевоеСвойство_Документа = СоздатьЗначениеXDTO("КлючевыеСвойстваОтчетОРозничныхПродажах");
	КлючевоеСвойство_Документа.Ссылка				= "" + Документ.УникальныйИдентификатор();
	КлючевоеСвойство_Документа.Дата					= Документ.Дата;
	КлючевоеСвойство_Документа.Номер 				= Документ.Номер;
	КлючевоеСвойство_Документа.Организация			= КлючевоеСвойство_Организация;
	
	// ДанныеXDTO - Чек ККМ
	ДанныеXDTO = СоздатьЗначениеXDTO("Документ.ОтчетОРозничныхПродажах");
	ДанныеXDTO.КлючевыеСвойства 	= КлючевоеСвойство_Документа;
	ДанныеXDTO.Валюта = КлючевоеСвойство_Валюта;
	ДанныеXDTO.Сумма = Документ.Всего;
	ДанныеXDTO.СуммаВключаетНДС = Истина;
	ДанныеXDTO.Склад = ПолучитьКлючевоеСвойство(Документ.Склад, ФайлОбмена, КЭШ, Документ);
	
	// Товары
	
	СтрокиТоварыXDTO = СоздатьЗначениеXDTO("Документ.ОтчетОРозничныхПродажах.Товары");
	
	ИндексСтроки = 0;
	Для Каждого СтрокаТовары Из Документ.Товары Цикл
		
		ДанныеНоменклатуры = СоздатьЗначениеXDTO("ОбщиеСвойстваДанныеНоменклатуры");
		ДанныеНоменклатуры.Номенклатура = ПолучитьКлючевоеСвойство(СтрокаТовары.Номенклатура, ФайлОбмена, КЭШ, Документ);
		
		ДанныеXDTOСтрокаТовары = СоздатьЗначениеXDTO("Документ.ОтчетОРозничныхПродажах.Товары.Строка");
		ДанныеXDTOСтрокаТовары.НомерСтрокиДокумента = ИндексСтроки;
		ДанныеXDTOСтрокаТовары.ДанныеНоменклатуры = ДанныеНоменклатуры;
		
		ЕдиницаИзмерения = СтрокаТовары.Номенклатура.БазоваяЕдиницаПоКлассификатору;
		ДанныеXDTOСтрокаТовары.ЕдиницаИзмерения = ПолучитьКлючевоеСвойство(ЕдиницаИзмерения, ФайлОбмена, КЭШ, Документ);
		
		ДанныеXDTOСтрокаТовары.Количество = СтрокаТовары.Количество;
		ДанныеXDTOСтрокаТовары.Сумма = СтрокаТовары.Всего;
		ДанныеXDTOСтрокаТовары.Цена = СтрокаТовары.Цена;
		
		ТипXDTO = ФабрикаXDTO.Тип(URI(), "СтавкиНДС");
		СтавкаНДС18 = ФабрикаXDTO.Создать(ТипXDTO, "НДС18");
		
		
		ДанныеXDTOСтрокаТовары.СтавкаНДС = СтавкаНДС18;
		
		ДанныеXDTOСтрокаТовары.СуммаНДС = СтрокаТовары.СуммаНДС;
		
		СтрокиТоварыXDTO.Строка.Добавить(ДанныеXDTOСтрокаТовары);
		
		ИндексСтроки = ИндексСтроки + 1;
		
	КонецЦикла;
	
	УстановитьДанные(ДанныеXDTO, "Товары", СтрокиТоварыXDTO);
	
	
	//ДанныеXDTO.Валюта				= КлючевоеСвойство_Валюта;
	//ДанныеXDTO.ВидОперации			= "ПокупкаУПоставщика";
	//ДанныеXDTO.Сумма				= Документ.Всего;
	//ДанныеXDTO.СуммаВключаетНДС		= Документ.СуммаВключаетНДС;
	//УстановитьДанные(ДанныеXDTO, "Склад", ПолучитьКлючевоеСвойство(Документ.Склад, ФайлОбмена, КЭШ, Документ));
	//ДанныеXDTO.Контрагент			= КлючевоеСвойство_Контрагент;
	//ДанныеXDTO.ДанныеВзаиморасчетов = ДанныеВзаиморасчетов;
	
	//УстановитьДанные(ДанныеXDTO, "Комментарий", "Комментарий");
	
	Возврат ДанныеXDTO;
	
КонецФункции // ПолучитьДанные_ОтчетОРозничныхПродажах()

Функция ПолучитьДанные_Проект(СправочникСсылка, ФайлОбмена, КЭШ)
	
	СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
	
	// ========================================================================
	// ДанныеXDTO - создаем сначала, потом заполняем
	// ========================================================================
	ДанныеXDTO = СоздатьЗначениеXDTO("Справочник.Проекты");
	
	// ========================================================================
	// Ключевое свойство справочника
	// ========================================================================
	КлючевоеСвойство_Проекта = СоздатьЗначениеXDTO("КлючевыеСвойстваПроект");
	КлючевоеСвойство_Проекта.Ссылка       = "" + СправочникОбъект.Ссылка.УникальныйИдентификатор();
	КлючевоеСвойство_Проекта.Наименование = СправочникОбъект.Наименование;
	
	ДанныеXDTO.КлючевыеСвойства = КлючевоеСвойство_Проекта;
	
	// ========================================================================
	// Группа (родитель) — выгружаем только если родитель является группой
	// ========================================================================
	Если ЗначениеЗаполнено(СправочникОбъект.Родитель) И СправочникОбъект.Родитель.ЭтоГруппа Тогда
		Попытка ДанныеXDTO.Сеть = ПолучитьКлючевоеСвойство_ПроектГруппа(СправочникОбъект.Родитель, ФайлОбмена, КЭШ, СправочникОбъект).КлючевыеСвойства; Исключение КонецПопытки;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СправочникОбъект.ОсновнойАдрес) Тогда
		ДанныеXDTO.ОсновнойАдрес =  Строка(СправочникОбъект.ОсновнойАдрес);
	КонецЕсли;
	тДопРеквизит = Неопределено;
	Для каждого стр Из СправочникОбъект.ДополнительныеРеквизиты Цикл
		Если стр.Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Бренд") Тогда
			тДопРеквизит = стр.Значение;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(тДопРеквизит) Тогда
		ДанныеXDTO.Бренд =  Строка(тДопРеквизит);
	КонецЕсли;
	тДопРеквизит = Неопределено;
	Для каждого стр Из СправочникОбъект.ДополнительныеРеквизиты Цикл
		Если стр.Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Концепция") Тогда
			тДопРеквизит = стр.Значение;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(тДопРеквизит) Тогда
		ДанныеXDTO.Концепция =  Строка(тДопРеквизит);
	КонецЕсли;
	Если СправочникСсылка.ПометкаУдаления Тогда
		ДанныеXDTO.ПометкаУдаления = Истина;
	КонецЕсли;
	
	Возврат ДанныеXDTO;
	
КонецФункции // ПолучитьДанные_Проект()

Функция ПолучитьДанные_ПроектГруппа(СправочникСсылка, ФайлОбмена, КЭШ)
	
	СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
	
	// ========================================================================
	// ДанныеXDTO - объект справочника группы
	// ========================================================================
	ДанныеXDTO = СоздатьЗначениеXDTO("Справочник.ПроектыГруппа");
	
	// ========================================================================
	// Ключевое свойство группы
	// ========================================================================
	КлючевоеСвойство_Группы = СоздатьЗначениеXDTO("КлючевыеСвойстваПроектГруппа");
	КлючевоеСвойство_Группы.Ссылка       = "" + СправочникОбъект.Ссылка.УникальныйИдентификатор();
	КлючевоеСвойство_Группы.Наименование = СправочникОбъект.Наименование;
	
	// Родительская группа (рекурсивно) — если есть и родитель тоже группа
	//Если ЗначениеЗаполнено(СправочникОбъект.Родитель) И СправочникОбъект.Родитель.ЭтоГруппа Тогда
	//    КлючевоеСвойство_Группы.Группа = ПолучитьКлючевоеСвойство_ПроектГруппа(СправочникОбъект.Родитель, ФайлОбмена, КЭШ, СправочникОбъект);
	//КонецЕсли;
	
	ДанныеXDTO.КлючевыеСвойства = КлючевоеСвойство_Группы;
	ДанныеXDTO.ИдБ24 =  СправочникОбъект.ИдБ24;
	Если ЗначениеЗаполнено(СправочникОбъект.Сеть) Тогда
		ДанныеXDTO.РазмерСети = Метаданные.Перечисления["СетьПроектов"].ЗначенияПеречисления[Перечисления["СетьПроектов"].Индекс(СправочникОбъект.Сеть)].Имя;
	КонецЕсли;
	Если СправочникСсылка.ПометкаУдаления Тогда
		ДанныеXDTO.ПометкаУдаления = Истина;
	КонецЕсли;
	
	Возврат ДанныеXDTO;
	
КонецФункции // ПолучитьДанные_ПроектГруппа()

&НаСервере
Процедура ВыгрузитьДанные(МассивДокументов, АдресВременногоХранилищя, ВыполняетсяВФоне = Ложь) Экспорт
	
	ИмяВременногоФайла = КаталогВременныхФайлов() + "\EnterpriseData.xml";
	
	ФайлОбмена = Новый ЗаписьXML;
	ФайлОбмена.ОткрытьФайл(ИмяВременногоФайла);
	ФайлОбмена.ЗаписатьОбъявлениеXML();
	
	// Записываем элемент <Message>
	ФайлОбмена.ЗаписатьНачалоЭлемента("Message");
	ФайлОбмена.ЗаписатьСоответствиеПространстваИмен("msg", "http://www.1c.ru/SSL/Exchange/Message");
	ФайлОбмена.ЗаписатьСоответствиеПространстваИмен("xs", "http://www.w3.org/2001/XMLSchema");
	ФайлОбмена.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance");
	ФайлОбмена.ЗаписатьСоответствиеПространстваИмен("ext", URIРасширение());

	// Записываем элемент <Header>
	Header = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(XMLБазоваяСхема(), "Header"));
	Header.Format 		= "http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.6";
	Header.CreationDate = ТекущаяДата();
	Header.AvailableVersion.Добавить("1.6");
	
	ФабрикаXDTO.ЗаписатьXML(ФайлОбмена, Header);
	
	// Записываем элемент <Body>
	ФайлОбмена.ЗаписатьНачалоЭлемента("Body");
	ФайлОбмена.ЗаписатьСоответствиеПространстваИмен("", "http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.6");
	
	КЭШ = Новый Структура;
	
	// Инициализация индикатора состояния выгрузки
	ЗначениеИндикатора = 0;
	КоличествоЗаписей = МассивДокументов.Количество();
	ДельтаИндикатора = ?(КоличествоЗаписей > 0, 100 / КоличествоЗаписей, 0);
	
	Для Каждого Документ Из МассивДокументов Цикл
		
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			ДанныеXDTO = ПолучитьДанные_РеализацияТоваровУслуг(Документ, ФайлОбмена, КЭШ);
		ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.КорректировкаДолга") Тогда
			ДанныеXDTO = ПолучитьДанные_КорректировкаДолга(Документ, ФайлОбмена, КЭШ);
		ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			ДанныеXDTO = ПолучитьДанные_ПоступлениеТоваровУслуг(Документ, ФайлОбмена, КЭШ);
		ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ОтчетОРозничныхПродажах") Тогда
			ДанныеXDTO = ПолучитьДанные_ОтчетОРозничныхПродажах(Документ, ФайлОбмена, КЭШ);
		ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.АвансовыйОтчет") Тогда
			ДанныеXDTO = ПолучитьДанные_АвансовыйОтчет(Документ, ФайлОбмена, КЭШ);
		ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.СчетНаОплатуПокупателю") Тогда
			ДанныеXDTO = ПолучитьДанные_СчетНаОплатуПокупателю(Документ, ФайлОбмена, КЭШ);
		ИначеЕсли ТипЗнч(Документ) = Тип("СправочникСсылка.Проекты") Тогда
			Если Документ.ЭтоГруппа Тогда
				ДанныеXDTO = ПолучитьДанные_ПроектГруппа(Документ, ФайлОбмена, КЭШ);
			Иначе
				ДанныеXDTO = ПолучитьДанные_Проект(Документ, ФайлОбмена, КЭШ);
			КонецЕсли;
		Иначе
			Продолжить; 
		КонецЕсли;
		
		ЗаписатьОбъектXDTO(ФайлОбмена, ДанныеXDTO);
		
		Если ВыполняетсяВФоне Тогда
			ЗначениеИндикатора = ЗначениеИндикатора + ДельтаИндикатора;
			СообщениеПользователю = Новый СообщениеПользователю;
			СообщениеПользователю.Текст = Строка(ЗначениеИндикатора);
			СообщениеПользователю.Сообщить();
		КонецЕсли;
		
	КонецЦикла;
	
	ФайлОбмена.ЗаписатьКонецЭлемента(); // Body
	ФайлОбмена.ЗаписатьКонецЭлемента(); // Message
	
	ФайлОбмена.Закрыть();
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	ПоместитьВоВременноеХранилище(ДвоичныеДанные, АдресВременногоХранилищя);
	
КонецПроцедуры // ВыгрузитьДанные()
