&НаСервере
Процедура ВыгрузитьДанные(МассивДокументов, АдресВременногоХранилищя, ВыполняетсяВФоне = Ложь) Экспорт
	
	ИмяВременногоФайла = КаталогВременныхФайлов() + "\EnterpriseData.xml";
	
	ФайлОбмена = Новый ЗаписьXML;
	ФайлОбмена.ОткрытьФайл(ИмяВременногоФайла);
	ФайлОбмена.ЗаписатьОбъявлениеXML();
	
	// Записываем элемент <Message>
	ФайлОбмена.ЗаписатьНачалоЭлемента("Message");
	ФайлОбмена.ЗаписатьСоответствиеПространстваИмен("msg", "http://www.1c.ru/SSL/Exchange/Message");
	ФайлОбмена.ЗаписатьСоответствиеПространстваИмен("xs", "http://www.w3.org/2001/XMLSchema");
	ФайлОбмена.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance");
	ФайлОбмена.ЗаписатьСоответствиеПространстваИмен("ext", URIРасширение());

	// Записываем элемент <Header>
	Header = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(XMLБазоваяСхема(), "Header"));
	Header.Format 		= "http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.6";
	Header.CreationDate = ТекущаяДата();
	Header.AvailableVersion.Добавить("1.6");
	
	ФабрикаXDTO.ЗаписатьXML(ФайлОбмена, Header);
	
	// Записываем элемент <Body>
	ФайлОбмена.ЗаписатьНачалоЭлемента("Body");
	ФайлОбмена.ЗаписатьСоответствиеПространстваИмен("", "http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.6");
	
	КЭШ = Новый Структура;
	
	// Инициализация индикатора состояния выгрузки
	ЗначениеИндикатора = 0;
	КоличествоЗаписей = МассивДокументов.Количество();
	ДельтаИндикатора = ?(КоличествоЗаписей > 0, 100 / КоличествоЗаписей, 0);
	
	Для Каждого Документ Из МассивДокументов Цикл
		
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			ДанныеXDTO = ПолучитьДанные_РеализацияТоваровУслуг(Документ, ФайлОбмена, КЭШ);
		ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.КорректировкаДолга") Тогда
			ДанныеXDTO = ПолучитьДанные_КорректировкаДолга(Документ, ФайлОбмена, КЭШ);
		ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			ДанныеXDTO = ПолучитьДанные_ПоступлениеТоваровУслуг(Документ, ФайлОбмена, КЭШ);
		ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ОтчетОРозничныхПродажах") Тогда
			ДанныеXDTO = ПолучитьДанные_ОтчетОРозничныхПродажах(Документ, ФайлОбмена, КЭШ);
		ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.АвансовыйОтчет") Тогда
			ДанныеXDTO = ПолучитьДанные_АвансовыйОтчет(Документ, ФайлОбмена, КЭШ);
		ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.СчетНаОплатуПокупателю") Тогда
			ДанныеXDTO = ПолучитьДанные_СчетНаОплатуПокупателю(Документ, ФайлОбмена, КЭШ);
		ИначеЕсли ТипЗнч(Документ) = Тип("СправочникСсылка.Проекты") Тогда
			Если Документ.ЭтоГруппа Тогда
				ДанныеXDTO = ПолучитьДанные_ПроектГруппа(Документ, ФайлОбмена, КЭШ);
			Иначе
				ДанныеXDTO = ПолучитьДанные_Проект(Документ, ФайлОбмена, КЭШ);
			КонецЕсли;
		ИначеЕсли ТипЗнч(Документ) = Тип("СправочникСсылка.Номенклатура") Тогда
			// Полный объект "Справочник.Номенклатура" формирует и записывает
			// СоздатьКлючевоеСвойство_Номенклатура; КЭШ защищает от повторной записи
			Если Не Документ.ЭтоГруппа Тогда
				ПолучитьКлючевоеСвойство(Документ, ФайлОбмена, КЭШ, Документ);
			КонецЕсли;
			Продолжить;
		ИначеЕсли ТипЗнч(Документ) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			// Полный объект "Справочник.Договоры" формирует и записывает
			// СоздатьКлючевоеСвойство_Договор; КЭШ защищает от повторной записи
			ПолучитьКлючевоеСвойство(Документ, ФайлОбмена, КЭШ, Документ);
			Продолжить;
		// Заготовки для типов из расширенного пакета: раскомментировать после
		// доработки пакета, проверив имена метаданных документов
		//ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.Спецификация") Тогда
		//	ДанныеXDTO = ПолучитьДанные_Спецификация(Документ, ФайлОбмена, КЭШ);
		//ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.УстановкаСтатусов") Тогда
		//	ДанныеXDTO = ПолучитьДанные_УстановкаСтатусов(Документ, ФайлОбмена, КЭШ);
		Иначе
			// Объекты из metadata_selected_cleaned.json обрабатывает генерируемый
			// диспетчер (см. область ГенерируемыйКодДХ); ручные ветки выше приоритетнее
			Если НЕ ПолучитьДанныеГенерируемогоОбъекта(Документ, ФайлОбмена, КЭШ, ДанныеXDTO) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ЗаписатьОбъектXDTO(ФайлОбмена, ДанныеXDTO);
		
		Если ВыполняетсяВФоне Тогда
			ЗначениеИндикатора = ЗначениеИндикатора + ДельтаИндикатора;
			СообщениеПользователю = Новый СообщениеПользователю;
			СообщениеПользователю.Текст = Строка(ЗначениеИндикатора);
			СообщениеПользователю.Сообщить();
		КонецЕсли;
		
	КонецЦикла;
	
	ФайлОбмена.ЗаписатьКонецЭлемента(); // Body
	ФайлОбмена.ЗаписатьКонецЭлемента(); // Message
	
	ФайлОбмена.Закрыть();
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	ПоместитьВоВременноеХранилище(ДвоичныеДанные, АдресВременногоХранилищя);
	
КонецПроцедуры // ВыгрузитьДанные()

