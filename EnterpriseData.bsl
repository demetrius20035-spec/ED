Функция ПолучитьДанные_Ген_КатегорииНоменклатуры(Ссылка, ФайлОбмена, КЭШ)

	Объект = Ссылка.ПолучитьОбъект();

	ДанныеXDTO = СоздатьЗначениеXDTO("Справочник.КатегорииНоменклатуры");
	ДанныеXDTO.КлючевыеСвойства = КлючевоеСвойствоГен_КатегорииНоменклатуры(Ссылка);

	Если ЗначениеЗаполнено(Объект.Автор) Тогда
		УстановитьДанные(ДанныеXDTO, "Автор", XMLСтрока(Объект.Автор));
	КонецЕсли;
	УстановитьДанные(ДанныеXDTO, "ДатаСоздания", Объект.ДатаСоздания);
	Если ЗначениеЗаполнено(Объект.НаборСвойств) Тогда
