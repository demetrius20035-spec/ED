Функция ПолучитьДанные_Ген_ПриходныйКассовыйОрдер(Ссылка, ФайлОбмена, КЭШ)

	Объект = Ссылка.ПолучитьОбъект();

	ДанныеXDTO = СоздатьЗначениеXDTO("Документ.ПриходныйКассовыйОрдер");
	ДанныеXDTO.КлючевыеСвойства = КлючевоеСвойствоГен_ПриходныйКассовыйОрдер(Ссылка);

	УстановитьДанные(ДанныеXDTO, "Операция", КлючевоеСвойствоГен_Операции(Объект.Операция));
	Если ЗначениеЗаполнено(Объект.Автор) Тогда
		УстановитьДанные(ДанныеXDTO, "Автор", XMLСтрока(Объект.Автор));
	КонецЕсли;
	УстановитьДанные(ДанныеXDTO, "ДатаСоздания", Объект.ДатаСоздания);
	ДанныеXDTO.УправленческийУчет = Объект.УправленческийУчет;
	ДанныеXDTO.БухгалтерскийУчет = Объект.БухгалтерскийУчет;
	УстановитьДанные(ДанныеXDTO, "Организация", ПолучитьКлючевоеСвойство(Объект.Организация, ФайлОбмена, КЭШ, Ссылка));
