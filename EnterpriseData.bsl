Функция СоздатьКлючевоеСвойство(Значение, ФайлОбмена, КЭШ, Документ)
	
	Если ТипЗнч(Значение) = Тип("СправочникСсылка.Валюты") Тогда
		Возврат СоздатьКлючевоеСвойство_Валюта(Значение, ФайлОбмена, КЭШ, Документ);
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.Организации") Тогда
		Возврат СоздатьКлючевоеСвойство_Организация(Значение, ФайлОбмена, КЭШ, Документ);
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат СоздатьКлючевоеСвойство_Контрагент(Значение, ФайлОбмена, КЭШ, Документ);
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		Возврат СоздатьКлючевоеСвойство_Договор(Значение, ФайлОбмена, КЭШ, Документ);
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.Номенклатура") Тогда
		Возврат СоздатьКлючевоеСвойство_Номенклатура(Значение, ФайлОбмена, КЭШ, Документ);
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.КлассификаторЕдиниц") Тогда
		Возврат СоздатьКлючевоеСвойство_КлассификаторЕдиниц(Значение, ФайлОбмена, КЭШ, Документ);
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.Склады") Тогда
		Возврат СоздатьКлючевоеСвойство_Склад(Значение, ФайлОбмена, КЭШ, Документ);
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.Кассы") Тогда
		Возврат СоздатьКлючевоеСвойство_КассаККМ(Значение, ФайлОбмена, КЭШ, Документ);
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.СтатьиЗатрат") Тогда
		Возврат СоздатьКлючевоеСвойство_СтатьяРасходов(Значение, ФайлОбмена, КЭШ, Документ);
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.Подразделения") Тогда
		Возврат СоздатьКлючевоеСвойство_Подразделение(Значение, ФайлОбмена, КЭШ, Документ);
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.Сотрудники") Тогда
		Возврат СоздатьКлючевоеСвойство_Сотрудник(Значение, ФайлОбмена, КЭШ, Документ);
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		Возврат СоздатьКлючевоеСвойство_ФизическоеЛицо(Значение, ФайлОбмена, КЭШ, Документ);
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.Проекты") Тогда
		Возврат СоздатьКлючевоеСвойство_Проект(Значение, ФайлОбмена, КЭШ, Документ);
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.Единицы") Тогда
		Возврат СоздатьКлючевоеСвойство_Единицы(Значение, ФайлОбмена, КЭШ, Документ);
	КонецЕсли;
	
КонецФункции // СоздатьКлючевоеСвойство()

