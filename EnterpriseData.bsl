	Если ЗначениеЗаполнено(Объект.СтатьяДвиженияДенежныхСредств) Тогда
		УстановитьДанные(ДанныеXDTO, "СтатьяДвиженияДенежныхСредств", XMLСтрока(Объект.СтатьяДвиженияДенежныхСредств));
	КонецЕсли;
	УстановитьДанные(ДанныеXDTO, "Счет", СсылкаДХ(Объект.Счет));
	УстановитьДанные(ДанныеXDTO, "Субконто1", СсылкаДХ(Объект.Субконто1));
