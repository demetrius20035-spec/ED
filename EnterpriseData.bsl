Функция СоздатьКлючевоеСвойство_Договор(Значение, ФайлОбмена, КЭШ, Документ)
	
	ВалютаРегламентированногоУчета = ПараметрыСеанса.ВалютаРегламентированногоУчета;
	
	КлючевоеСвойство = СоздатьТиповоеЗначениеXDTO("КлючевыеСвойстваДоговор");
	//КлючевоеСвойство.Ссылка = "" + Значение.УникальныйИдентификатор();
	
	// Вид договора
	ВидДоговора = Значение.ВидДоговора;
	Если ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
		КлючевоеСвойство.ВидДоговора = "СПокупателем"; 
	ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
		КлючевоеСвойство.ВидДоговора = "СПоставщиком"; 
	Иначе
		КлючевоеСвойство.ВидДоговора = "СПокупателем"; // СПокупателем по умолчанию
	КонецЕсли;
	
	Если Строка(ТипЗнч(Документ)) = "Поступление товаров услуг" Тогда
		КлючевоеСвойство.ВидДоговора = "СПоставщиком";
	КонецЕсли;
	
	// Организация 
	Организация = Значение.Организация;
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = Документ.Организация;
		// Сообщить("Организация: " + Организация + " " + Документ);
	КонецЕсли;	
	УстановитьДанные(КлючевоеСвойство, "Организация", ПолучитьКлючевоеСвойство(Организация, ФайлОбмена, КЭШ, Документ));
	
	УстановитьДанные(КлючевоеСвойство, "Контрагент", ПолучитьКлючевоеСвойство(Значение.Владелец, ФайлОбмена, КЭШ, Документ));
	УстановитьДанные(КлючевоеСвойство, "ВалютаВзаиморасчетов", ПолучитьКлючевоеСвойство(ВалютаРегламентированногоУчета, ФайлОбмена, КЭШ, Документ));
	КлючевоеСвойство.РасчетыВУсловныхЕдиницах = Ложь;
	// КлючевоеСвойство.Наименование = Значение.Наименование;
	КлючевоеСвойство.Наименование = "Основной договор";
	
	Если ЗначениеЗаполнено(Значение.ДатаНачала) И Значение.ДатаНачала <> '00010101' Тогда
		КлючевоеСвойство.Дата = Значение.ДатаНачала;
	КонецЕсли;
	//КлючевоеСвойство.Дата = Значение.ДатаНачала;
	// УстановитьДанные(КлючевоеСвойство, "Номер", Значение.НомерДоговора);
	
	ДанныеXDTO = СоздатьТиповоеЗначениеXDTO("Справочник.Договоры");
	ДанныеXDTO.КлючевыеСвойства		= КлючевоеСвойство;
	ДанныеXDTO.СрокДействия 		= Значение.ДатаОкончания;
	УстановитьДанные(ДанныеXDTO, "Комментарий", Значение.Комментарий);
	
	// ДанныеXDTO.УчетАгентскогоНДС
	// ДанныеXDTO.ГруппаНастроекФинансовогоУчетаРасчетов;
	// ДанныеXDTO.БанковскийСчет
	// ДанныеXDTO.БанковскийСчетОрганизации
	// ДанныеXDTO.ДополнительныеРеквизиты
	// ДанныеXDTO.ТипЦен
	// ДанныеXDTO.СрокКонтроляОплатыВДнях
	
	
	Возврат КлючевоеСвойство;
	
КонецФункции // СоздатьКлючевоеСвойство_Договор()

Функция СоздатьКлючевоеСвойство_Номенклатура(Значение, ФайлОбмена, КЭШ, Документ)
	
	КлючевоеСвойство = СоздатьТиповоеЗначениеXDTO("КлючевыеСвойстваНоменклатура");
	КлючевоеСвойство.Ссылка = "" + Значение.УникальныйИдентификатор();
	КлючевоеСвойство.НаименованиеПолное = Значение.НаименованиеПолное;
	КлючевоеСвойство.КодВПрограмме = Значение.Код;
	УстановитьДанные(КлючевоеСвойство, "Артикул", Значение.Артикул);
	КлючевоеСвойство.Наименование = Значение.Наименование;
	
	ДанныеXDTO = СоздатьТиповоеЗначениеXDTO("Справочник.Номенклатура");
	ДанныеXDTO.КлючевыеСвойства		= КлючевоеСвойство;
	
	ТипНоменклатуры = Значение.ВидНоменклатуры.ТипНоменклатуры;
	Если ТипНоменклатуры = Перечисления.ТипНоменклатуры.Товары Тогда 
		ДанныеXDTO.ТипНоменклатуры = "Товар";
	ИначеЕсли ТипНоменклатуры = Перечисления.ТипНоменклатуры.Услуги Тогда
		ДанныеXDTO.ТипНоменклатуры = "Услуга";
	ИначеЕсли ТипНоменклатуры = Перечисления.ТипНоменклатуры.Лицензии Тогда
		ДанныеXDTO.ТипНоменклатуры = "Услуга";
	ИначеЕсли ТипНоменклатуры = Перечисления.ТипНоменклатуры.ГотоваяПродукция Тогда
		ДанныеXDTO.ТипНоменклатуры = "Товар";
	ИначеЕсли ТипНоменклатуры = Перечисления.ТипНоменклатуры.Работа Тогда
		ДанныеXDTO.ТипНоменклатуры = "Работа";
	Иначе
		ДанныеXDTO.ТипНоменклатуры = "Товар";
	КонецЕсли;
	
	УстановитьДанные(ДанныеXDTO, "Описание", Значение.Описание);
	
	Единица = Значение.ОсновнаяЕдиница.Единица;
	УстановитьДанные(ДанныеXDTO, "ЕдиницаИзмерения", ПолучитьКлючевоеСвойство(Единица, ФайлОбмена, КЭШ, Документ));
	
	
	Возврат КлючевоеСвойство;
	
КонецФункции // СоздатьКлючевоеСвойство_Номенклатура()

