Функция ПолучитьКлючевоеСвойство(Значение, ФайлОбмена, КЭШ, Документ)
	
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	
	//Сообщить("--------------------------------");
	//Сообщить(Значение.УникальныйИдентификатор());
	//Сообщить(Значение);
	
	УникальныйИдентификатор = Значение.УникальныйИдентификатор();
	УникальныйИдентификатор = "GUID" + УникальныйИдентификатор;
	УникальныйИдентификатор = СтрЗаменить(УникальныйИдентификатор, "-", "");	
	
	КлючевоеСвойство = "";
	
	Если НЕ КЭШ.Свойство(УникальныйИдентификатор, КлючевоеСвойство) Тогда
		КлючевоеСвойство = СоздатьКлючевоеСвойство(Значение, ФайлОбмена, КЭШ, Документ);
		КЭШ.Вставить(УникальныйИдентификатор, КлючевоеСвойство);
	КонецЕсли;
	
	Возврат КлючевоеСвойство;
	
КонецФункции // ПолучитьКлючевоеСвойство()

Функция ПолучитьДанные_РеализацияТоваровУслуг(Документ, ФайлОбмена, КЭШ)
	
	// Валюта
	ВалютаРегламентированногоУчета = ПараметрыСеанса.ВалютаРегламентированногоУчета;
	КлючевоеСвойство_Валюта = ПолучитьКлючевоеСвойство(ВалютаРегламентированногоУчета, ФайлОбмена, КЭШ, Документ);
	
	// Организация
	Организация = Документ.Организация;
	КлючевоеСвойство_Организация = ПолучитьКлючевоеСвойство(Организация, ФайлОбмена, КЭШ, Документ);
	
	// Контаргент
	Контрагент = Документ.Контрагент;
	КлючевоеСвойство_Контрагент = ПолучитьКлючевоеСвойство(Контрагент, ФайлОбмена, КЭШ, Документ);
	
	
	// Ключевое свойство - Реализация товаров услуг
	КлючевоеСвойство_РеализацияТоваровУслуг = СоздатьЗначениеXDTO("КлючевыеСвойстваРеализацияТоваровУслуг");
	КлючевоеСвойство_РеализацияТоваровУслуг.Ссылка		= "" + Документ.УникальныйИдентификатор();
	КлючевоеСвойство_РеализацияТоваровУслуг.Дата		= Документ.Дата;
	КлючевоеСвойство_РеализацияТоваровУслуг.Номер		= Документ.Номер;
	КлючевоеСвойство_РеализацияТоваровУслуг.Организация	= КлючевоеСвойство_Организация;
	
	// Ключевое свойство - Договор
	
	ДоговорКонтрагента = Документ.ДоговорКонтрагента;
	Если ЗначениеЗаполнено(Документ.Контрагент.ОсновнойДоговорБухгалтерскогоУчета) Тогда
		ДоговорКонтрагента = Документ.Контрагент.ОсновнойДоговорБухгалтерскогоУчета;
	Иначе
		ДоговорКонтрагента = Документ.ДоговорКонтрагента;
	КонецЕсли;
	
	
	КлючевоеСвойство_Договор = ПолучитьКлючевоеСвойство(ДоговорКонтрагента, ФайлОбмена, КЭШ, Документ);
	
	
	// ДанныеВзаиморасчетов
	ДанныеВзаиморасчетов = СоздатьЗначениеXDTO("ОбщиеСвойстваДанныеВзаиморасчетов");
	ДанныеВзаиморасчетов.Договор = КлючевоеСвойство_Договор;
	ДанныеВзаиморасчетов.ВалютаВзаиморасчетов = КлючевоеСвойство_Валюта;
	ДанныеВзаиморасчетов.КурсВзаиморасчетов = 1;
	ДанныеВзаиморасчетов.КратностьВзаиморасчетов = 1;
	ДанныеВзаиморасчетов.РасчетыВУсловныхЕдиницах = Ложь;
	// ДанныеВзаиморасчетов.СчетУчетаРасчетовСКонтрагентом = "";
	// ДанныеВзаиморасчетов.СчетУчетаРасчетовПоАвансам = "";
	
	
	// ДанныеXDTO - Реализация товаров услуг
	ДанныеXDTO = СоздатьЗначениеXDTO("Документ.РеализацияТоваровУслуг");
	ДанныеXDTO.КлючевыеСвойства 	= КлючевоеСвойство_РеализацияТоваровУслуг;
	ДанныеXDTO.ВидОперации			= "РеализацияКлиенту";
	ДанныеXDTO.Валюта				= КлючевоеСвойство_Валюта;
	ДанныеXDTO.Сумма				= Документ.Всего;
	ДанныеXDTO.СуммаВключаетНДС		= Документ.СуммаВключаетНДС;
	УстановитьДанные(ДанныеXDTO, "Склад", ПолучитьКлючевоеСвойство(Документ.Склад, ФайлОбмена, КЭШ, Документ));
	ДанныеXDTO.Контрагент			= КлючевоеСвойство_Контрагент;
	ДанныеXDTO.ДанныеВзаиморасчетов = ДанныеВзаиморасчетов;
	
	УстановитьДанные(ДанныеXDTO, "Комментарий", "Комментарий");
	
	// Товары
	
	СтрокиТоварыXDTO = СоздатьЗначениеXDTO("Документ.РеализацияТоваровУслуг.Товары");
	
	ИндексСтроки = 0;
	Для Каждого СтрокаТовары Из Документ.Товары Цикл
		
		Если СтрокаТовары.Всего = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеНоменклатуры = СоздатьЗначениеXDTO("ОбщиеСвойстваДанныеНоменклатуры");
		ДанныеНоменклатуры.Номенклатура = ПолучитьКлючевоеСвойство(СтрокаТовары.Номенклатура, ФайлОбмена, КЭШ, Документ);
		
		ДанныеXDTOСтрокаТовары = СоздатьЗначениеXDTO("Документ.РеализацияТоваровУслуг.Товары.Строка");
		ДанныеXDTOСтрокаТовары.НомерСтрокиДокумента = ИндексСтроки;
		ДанныеXDTOСтрокаТовары.ДанныеНоменклатуры = ДанныеНоменклатуры;
		
		ЕдиницаИзмерения = СтрокаТовары.Единица.Единица;
		ДанныеXDTOСтрокаТовары.ЕдиницаИзмерения = ПолучитьКлючевоеСвойство(ЕдиницаИзмерения, ФайлОбмена, КЭШ, Документ);
		ДанныеXDTOСтрокаТовары.Количество = Окр(СтрокаТовары.Количество, 3, РежимОкругления.Окр15как20);
		ДанныеXDTOСтрокаТовары.Сумма = СтрокаТовары.Всего;
		ДанныеXDTOСтрокаТовары.Цена = ?(СтрокаТовары.Количество=0, 0, Окр(СтрокаТовары.Всего / СтрокаТовары.Количество, 2, РежимОкругления.Окр15как20));
		
		СтавкаНДС = ПолучитьСтавкуНДС(СтрокаТовары.СтавкаНДС);
		Если СтавкаНДС <> Неопределено Тогда
			ДанныеXDTOСтрокаТовары.СтавкаНДС = СтавкаНДС;
		КонецЕсли;
		
		ДанныеXDTOСтрокаТовары.СуммаНДС = СтрокаТовары.СуммаНДС;
		
		СтрокиТоварыXDTO.Строка.Добавить(ДанныеXDTOСтрокаТовары);
		
		ИндексСтроки = ИндексСтроки + 1;
		
	КонецЦикла;
	
	УстановитьДанные(ДанныеXDTO, "Товары", СтрокиТоварыXDTO);
	
	// Услуги
	
	СтрокиТоварыXDTO = СоздатьЗначениеXDTO("Документ.РеализацияТоваровУслуг.Услуги");
	
	ИндексСтроки = 0;
	Для Каждого СтрокаТовары Из Документ.Услуги Цикл
		
		Если СтрокаТовары.Всего = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеXDTOСтрокаУслуги = СоздатьЗначениеXDTO("Документ.РеализацияТоваровУслуг.Услуги.Строка");
		ДанныеXDTOСтрокаУслуги.НомерСтрокиДокумента = ИндексСтроки;
		ДанныеXDTOСтрокаУслуги.Номенклатура = ПолучитьКлючевоеСвойство(СтрокаТовары.Номенклатура, ФайлОбмена, КЭШ, Документ);
		
		ДанныеXDTOСтрокаУслуги.Количество = Окр(СтрокаТовары.Количество, 3, РежимОкругления.Окр15как20);
		ДанныеXDTOСтрокаУслуги.Сумма = СтрокаТовары.Всего;
		ДанныеXDTOСтрокаУслуги.Цена = ?(СтрокаТовары.Количество=0, 0, Окр(СтрокаТовары.Всего / СтрокаТовары.Количество, 2, РежимОкругления.Окр15как20));
		
		СтавкаНДС = ПолучитьСтавкуНДС(СтрокаТовары.СтавкаНДС);
		Если СтавкаНДС <> Неопределено Тогда
			ДанныеXDTOСтрокаУслуги.СтавкаНДС = СтавкаНДС;
		КонецЕсли;
		
		ДанныеXDTOСтрокаУслуги.СуммаНДС = СтрокаТовары.СуммаНДС;
		
		ДанныеXDTOСтрокаУслуги.Содержание = СтрокаТовары.Содержание;
		
		СтрокиТоварыXDTO.Строка.Добавить(ДанныеXDTOСтрокаУслуги);
		
		ИндексСтроки = ИндексСтроки + 1;
		
	КонецЦикла;
	
	// Лицензии
	
	Для Каждого СтрокаТовары Из Документ.Лицензии Цикл
		
		Если СтрокаТовары.Всего = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеXDTOСтрокаУслуги = СоздатьЗначениеXDTO("Документ.РеализацияТоваровУслуг.Услуги.Строка");
		ДанныеXDTOСтрокаУслуги.НомерСтрокиДокумента = ИндексСтроки;
		ДанныеXDTOСтрокаУслуги.Номенклатура = ПолучитьКлючевоеСвойство(СтрокаТовары.Номенклатура, ФайлОбмена, КЭШ, Документ);
		
		ДанныеXDTOСтрокаУслуги.Количество = Окр(СтрокаТовары.Количество, 3, РежимОкругления.Окр15как20);
		ДанныеXDTOСтрокаУслуги.Сумма = СтрокаТовары.Всего;
		ДанныеXDTOСтрокаУслуги.Цена = ?(СтрокаТовары.Количество=0, 0, Окр(СтрокаТовары.Всего / СтрокаТовары.Количество, 2, РежимОкругления.Окр15как20));
		
		СтавкаНДС = ПолучитьСтавкуНДС(СтрокаТовары.СтавкаНДС);
		Если СтавкаНДС <> Неопределено Тогда
			ДанныеXDTOСтрокаУслуги.СтавкаНДС = СтавкаНДС;
		КонецЕсли;
		
		ДанныеXDTOСтрокаУслуги.СуммаНДС = СтрокаТовары.СуммаНДС;
		ДанныеXDTOСтрокаУслуги.Содержание = СтрокаТовары.Содержание;
		
		СтрокиТоварыXDTO.Строка.Добавить(ДанныеXDTOСтрокаУслуги);
		
		ИндексСтроки = ИндексСтроки + 1;
		
	КонецЦикла;
	
	УстановитьДанные(ДанныеXDTO, "Услуги", СтрокиТоварыXDTO);
	
	Возврат ДанныеXDTO;
	
КонецФункции // ПолучитьДанные_РеализацияТоваровУслуг()

Функция СоздатьКлючевоеСвойство_ПроектГруппа(Значение, ФайлОбмена, КЭШ, Документ)
	
	// Ключевое свойство группы проектов
	КлючевоеСвойство = СоздатьЗначениеXDTO("КлючевыеСвойстваПроектГруппа");
	КлючевоеСвойство.Ссылка       = "" + Значение.УникальныйИдентификатор();
	КлючевоеСвойство.Наименование = Значение.Наименование;
	
	// Рекурсивно — родительская группа
	Если ЗначениеЗаполнено(Значение.Родитель) Тогда
		КлючевоеСвойство.Группа = ПолучитьКлючевоеСвойство_ПроектГруппа(Значение.Родитель, ФайлОбмена, КЭШ, Документ);
	КонецЕсли;
	
	// Сама группа как объект справочника
	ДанныеXDTO = СоздатьЗначениеXDTO("Справочник.ПроектыГруппа");
	ДанныеXDTO.КлючевыеСвойства = КлючевоеСвойство;
	
	Возврат ДанныеXDTO;
	
КонецФункции // СоздатьКлючевоеСвойство_ПроектГруппа()

Функция ПолучитьКлючевоеСвойство_ПроектГруппа(Значение, ФайлОбмена, КЭШ, Документ)
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	
	// В КЭШ кладём отдельным префиксом, чтобы не путать с обычными проектами
	УникальныйИдентификатор = "GROUP_" + СтрЗаменить("" + Значение.УникальныйИдентификатор(), "-", "");
	
	КлючевоеСвойство = "";
	Если НЕ КЭШ.Свойство(УникальныйИдентификатор, КлючевоеСвойство) Тогда
		КлючевоеСвойство = СоздатьКлючевоеСвойство_ПроектГруппа(Значение, ФайлОбмена, КЭШ, Документ);
		КЭШ.Вставить(УникальныйИдентификатор, КлючевоеСвойство);
	КонецЕсли;
	
	Возврат КлючевоеСвойство;
	
КонецФункции // ПолучитьКлючевоеСвойство_ПроектГруппа()

Функция СоздатьКлючевоеСвойство_Проект(Значение, ФайлОбмена, КЭШ, Документ)
	
	// Ключевое свойство проекта
	КлючевоеСвойство = СоздатьЗначениеXDTO("КлючевыеСвойстваПроект");
	КлючевоеСвойство.Ссылка       = "" + Значение.УникальныйИдентификатор();
	КлючевоеСвойство.Наименование = Значение.Наименование;
	
	// НаименованиеПолное — необязательное, заполняем если есть
	Если Значение.Метаданные().Реквизиты.Найти("НаименованиеПолное") <> Неопределено Тогда
		Если ЗначениеЗаполнено(Значение.НаименованиеПолное) Тогда
			КлючевоеСвойство.НаименованиеПолное = Значение.НаименованиеПолное;
		КонецЕсли;
	КонецЕсли;
	
	// Сам объект справочника
	ДанныеXDTO = СоздатьЗначениеXDTO("Справочник.Проекты");
	ДанныеXDTO.КлючевыеСвойства = КлючевоеСвойство;
	
	// Группа (родитель) — только если родитель является группой, не элементом
	//Если ЗначениеЗаполнено(Значение.Родитель) И Значение.Родитель.ЭтоГруппа Тогда
	//	ДанныеXDTO.Группа = ПолучитьКлючевоеСвойство_ПроектГруппа(Значение.Родитель, ФайлОбмена, КЭШ, Документ);
	//КонецЕсли;
	
	// ДополнительнаяИнформация — если есть такой реквизит
	Если Значение.Метаданные().Реквизиты.Найти("ДополнительнаяИнформация") <> Неопределено Тогда
		УстановитьДанные(ДанныеXDTO, "ДополнительнаяИнформация", Значение.ДополнительнаяИнформация);
	КонецЕсли;

	// Полный объект уезжает в файл попутно (как у остальных ключевых свойств),
	// а вызывающему возвращаются именно ключевые свойства: поля "Проект"
	// в строках счетов и в генерируемом коде типизированы КлючевыеСвойстваПроект
	ЗаписатьОбъектXDTO(ФайлОбмена, ДанныеXDTO);

	Возврат КлючевоеСвойство;

КонецФункции // СоздатьКлючевоеСвойство_Проект()

Функция ПолучитьПодписантов(Дата, Организация)
	
	ОтветственныеЛица = Новый Структура;
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);	
	Запрос.Текст = "ВЫБРАТЬ
	|	ОтветственныеЛицаОрганизацииСрезПоследних.Период КАК Период,
	|	ОтветственныеЛицаОрганизацииСрезПоследних.Организация КАК Организация,
	|	ОтветственныеЛицаОрганизацииСрезПоследних.Роль КАК Роль,
	|	ОтветственныеЛицаОрганизацииСрезПоследних.Сотрудник КАК Сотрудник,
	|	ОтветственныеЛицаОрганизацииСрезПоследних.Сотрудник.Ссылка КАК Ссылка,
	|	ОтветственныеЛицаОрганизацииСрезПоследних.Должность КАК Должность,
	|	ОтветственныеЛицаОрганизацииСрезПоследних.Сотрудник.ФИОДляПодписи КАК ФИОДляПодписи,
	|	ОтветственныеЛицаОрганизацииСрезПоследних.ПравоПодписи КАК ПравоПодписи
	|ИЗ
	|	РегистрСведений.ОтветственныеЛицаОрганизации.СрезПоследних КАК ОтветственныеЛицаОрганизацииСрезПоследних
	|ГДЕ
	|	ОтветственныеЛицаОрганизацииСрезПоследних.Организация = &Организация
	|	И ОтветственныеЛицаОрганизацииСрезПоследних.Период >= &Период";
	
	Результат = Запрос.Выполнить();
	Возврат Результат.Выгрузить();
	
КонецФункции

Функция ПолучитьДанные_КорректировкаДолга(Документ, ФайлОбмена, КЭШ)
	
	Если Строка(ТипЗНЧ(Документ.ДокументОснование)) = "Реализация товаров услуг" Тогда
		
		#Область РеализацияТоваровУслуг
		
		#Область ТелоДокумента
		ДанныеXDTO = СоздатьЗначениеXDTO("Документ.КорректировкаРеализацииТоваров");
		
		#Область ИсточникДанных
		Подписанты = ПолучитьПодписантов(Документ.Дата, Документ.Организация);
		
		Руководитель 				= Новый Структура("Должность, Ссылка, ПолноеФИО, ФИОДляПодписи", "", "", "", "");
		ГлавныйБухгалтер 			= Новый Структура("Должность, Ссылка, ПолноеФИО, ФИОДляПодписи", "", "", "", "");
		ОтвЗаПравОформФактаХозЖизни = Новый Структура("Должность, Ссылка, ПолноеФИО, ФИОДляПодписи", "", "", "", "");
		
		Если ЗначениеЗаполнено(Подписанты) Тогда 
			Для Каждого стр Из Подписанты Цикл
				Если стр.Роль = Перечисления.РолиОтветственныxЛицОрганизации.Руководитель Тогда
					Руководитель.Вставить("Должность", стр.Должность);
					Руководитель.Вставить("Ссылка", стр.Ссылка);
					Руководитель.Вставить("ПолноеФИО", стр.Сотрудник);
					Руководитель.Вставить("ФИОДляПодписи", стр.ФИОДляПодписи);
				ИначеЕсли стр.Роль = Перечисления.РолиОтветственныxЛицОрганизации.ГлавныйБухгалтер Тогда
					ГлавныйБухгалтер.Вставить("Должность", стр.Должность);
					ГлавныйБухгалтер.Вставить("Ссылка", стр.Ссылка);
					ГлавныйБухгалтер.Вставить("ПолноеФИО", стр.Сотрудник);
					ГлавныйБухгалтер.Вставить("ФИОДляПодписи", стр.ФИОДляПодписи);
				ИначеЕсли стр.Роль = Перечисления.РолиОтветственныxЛицОрганизации.ОтветственныйЗаПравильностьОформленияФактаХозяйственнойЖизни Тогда
					ОтвЗаПравОформФактаХозЖизни.Вставить("Должность", стр.Должность);
					ОтвЗаПравОформФактаХозЖизни.Вставить("Ссылка", стр.Ссылка);
					ОтвЗаПравОформФактаХозЖизни.Вставить("ПолноеФИО", стр.Сотрудник);
					ОтвЗаПравОформФактаХозЖизни.Вставить("ФИОДляПодписи", стр.ФИОДляПодписи);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		#КонецОбласти
		
		// Организация ++
		Организация = Документ.Организация;
		КлючевоеСвойство_Организация  = СоздатьЗначениеXDTO("КлючевыеСвойстваОрганизация");
		
		КлючевоеСвойство_Организация.Ссылка = "" + Документ.Организация.УникальныйИдентификатор(); //либо - Документ.УникальныйИдентификатор
		//КлючевоеСвойство_Организация = ПолучитьКлючевоеСвойство(Организация, ФайлОбмена, КЭШ, Документ);
		КлючевоеСвойство_Организация.Наименование = Документ.Организация.НаименованиеДляДокументов;
		КлючевоеСвойство_Организация.НаименованиеСокращенное = Документ.Организация.НаименованиеДляДокументов;
		КлючевоеСвойство_Организация.НаименованиеПолное = Документ.Организация.НаименованиеПолное;
		КлючевоеСвойство_Организация.ИНН = Документ.Организация.ИНН;
		КлючевоеСвойство_Организация.КПП = Документ.Организация.КППСтр;
		
		Если СтрДлина(КлючевоеСвойство_Организация.ИНН) = 10 Тогда
			КлючевоеСвойство_Организация.ЮридическоеФизическоеЛицо	= "ЮридическоеЛицо";
		ИначеЕсли СтрДлина(КлючевоеСвойство_Организация.ИНН) = 12 Тогда
			КлючевоеСвойство_Организация.ЮридическоеФизическоеЛицо	= "ФизическоеЛицо";
		КонецЕсли;
		
		//второй раз реализацию в корректировке указывать нельзя
		тФлаг = Истина;
		//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
		// Данный фрагмент построен конструктором.
		// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КорректировкаДолга.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.КорректировкаДолга КАК КорректировкаДолга
		|ГДЕ
		|	КорректировкаДолга.Ссылка <> &Ссылка
		|	И КорректировкаДолга.ДокументОснование = &ДокументОснование
		|	И КорректировкаДолга.Проведен
		|	И КорректировкаДолга.Дата < &Дата
		|
		|УПОРЯДОЧИТЬ ПО
		|	КорректировкаДолга.Дата";
		
		Запрос.УстановитьПараметр("ДокументОснование", Документ.ДокументОснование);
		Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);
		Запрос.УстановитьПараметр("Дата", Документ.Дата);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			тФлаг = Ложь;
			тСсылка = ВыборкаДетальныеЗаписи.Ссылка;
		КонецЦикла;
		
		//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
		
		// Ключевое свойство - Корректировка Реализации Товаров 
		КлючевоеСвойство_КорректировкаРеализацииТоваров 			= СоздатьЗначениеXDTO("КлючевыеСвойстваКорректировкаРеализацииТоваров");
		//Если тФлаг Тогда
		КлючевоеСвойство_КорректировкаРеализацииТоваров.Ссылка		= "" + Документ.УникальныйИдентификатор();
		КлючевоеСвойство_КорректировкаРеализацииТоваров.Дата		= Документ.Дата;
		КлючевоеСвойство_КорректировкаРеализацииТоваров.Номер		= Документ.Номер;
		//Иначе
		//    КлючевоеСвойство_КорректировкаРеализацииТоваров.Ссылка		= "" + тСсылка.УникальныйИдентификатор();
		//	КлючевоеСвойство_КорректировкаРеализацииТоваров.Дата		= тСсылка.Дата;
		//    КлючевоеСвойство_КорректировкаРеализацииТоваров.Номер		= тСсылка.Номер;
		//КонецЕсли;
