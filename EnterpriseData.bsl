	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.НаборСвойствХарактеристики) Тогда
		УстановитьДанные(ДанныеXDTO, "НаборСвойствХарактеристики", XMLСтрока(Объект.НаборСвойствХарактеристики));
	КонецЕсли;
	УстановитьДанные(ДанныеXDTO, "Комментарий", Объект.Комментарий);
	Если Объект.ПометкаУдаления Тогда
		ДанныеXDTO.ПометкаУдаления = Истина;
